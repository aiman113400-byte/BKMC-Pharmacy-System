@page
@model BKMC.Pharmacy.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - BKMC Pharmacy</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #eef2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        /* ================= CENTERED CARD WRAPPER ================= */
        .login-wrapper {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            width: 100%;
            max-width: 780px;
            min-height: 470px;
            display: flex;
        }

        /* ================= LEFT PANEL (Matched with Sidebar) ================= */
        .left-panel {
            background-color: #0d5c56;    /* ← Sidebar se match */
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.75rem 1.5rem;
            height: 100%;
        }

        .logo-box {
            width: 38px;
            height: 38px;
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.12);
        }

        .left-company {
            font-size: 0.58rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.75);
            margin-bottom: 0.4rem;
        }

        .left-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
        }

        .left-subtitle {
            font-size: 0.72rem;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.5;
            margin-bottom: 0;
            max-width: 240px;
        }

        .left-footer {
            font-size: 0.62rem;
            color: rgba(255, 255, 255, 0.7);
            display: flex;
            align-items: flex-start;
            gap: 6px;
            line-height: 1.4;
        }

        .left-footer i {
            margin-top: 2px;
        }

        /* ================= RIGHT PANEL (Form) ================= */
        .right-panel {
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.75rem;
            height: 100%;
        }

        .form-container {
            width: 100%;
            max-width: 280px;
        }

        .form-heading {
            font-size: 1.2rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .form-subheading {
            font-size: 0.72rem;
            color: #64748b;
            margin-bottom: 1.25rem;
        }

        .form-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.35rem;
        }

        .input-wrapper {
            position: relative;
            margin-bottom: 0.85rem;
        }

        .input-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .form-control-custom {
            width: 100%;
            height: 38px;
            padding-left: 36px;
            padding-right: 12px;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            background-color: #f8fafc;
            font-size: 0.8rem;
            transition: all 0.2s;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: #0d5c56;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(13, 92, 86, 0.15);
        }

        .form-control-custom::placeholder {
            color: #9ca3af;
            font-size: 0.78rem;
        }

        /* ================= SIGN IN BUTTON (Matched with Sidebar) ================= */
        .login-button {
            width: 100%;
            height: 38px;
            border: none;
            border-radius: 8px;
            background: #0d5c56;    /* ← Sidebar se match */
            color: #ffffff;
            font-weight: 600;
            font-size: 0.82rem;
            margin-top: 6px;
            transition: background 0.2s;
        }

        .login-button:hover {
            background: #094a44;    /* Thoda aur dark */
            color: #ffffff;
        }

        /* ================= RESPONSIVE ================= */
        @@media (max-width: 991.98px) {
            .login-wrapper {
                flex-direction: column;
                min-height: auto;
                max-width: 420px;
            }
            .left-panel {
                padding: 1.5rem;
                min-height: 200px;
            }
            .right-panel {
                padding: 1.75rem 1.5rem;
            }
        }
    </style>
</head>

<body>

    <!-- CENTERED WRAPPER -->
    <div class="login-wrapper">

        <!-- ================= LEFT PANEL (Branding) ================= -->
        <div class="col-lg-5 col-xl-5 d-flex flex-column">
            <div class="left-panel h-100">

                <div>
                    <div class="logo-box mb-3">
                        <i class="bi bi-capsule"></i>
                    </div>

                    <p class="left-company">MTI Swabi Medical Complex</p>
                    <h1 class="left-title">BKMC Pharmacy</h1>
                    <p class="left-subtitle">Hospital Inventory, Patient Dispensing &amp; Claim Settlement System</p>
                </div>

                <div class="left-footer mt-3">
                    <i class="bi bi-shield-lock"></i>
                    <span>Authorized Hospital Personnel Only. End-to-End Audited.</span>
                </div>

            </div>
        </div>

        <!-- ================= RIGHT PANEL (Login Form) ================= -->
        <div class="col-lg-7 col-xl-7 d-flex flex-column">
            <div class="right-panel h-100">

                <div class="form-container">

                    <h2 class="form-heading">Sign In</h2>
                    <p class="form-subheading">Enter your credentials to access the admin portal</p>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger small py-2 px-3" style="border-radius: 8px; font-size: 0.75rem;">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">

                        <div>
                            <label asp-for="LoginRequest.Username" class="form-label">Username</label>
                            <div class="input-wrapper">
                                <i class="bi bi-person"></i>
                                <input asp-for="LoginRequest.Username"
                                       class="form-control-custom"
                                       placeholder="Enter username"
                                       autocomplete="username" />
                            </div>
                        </div>

                        <div>
                            <label asp-for="LoginRequest.Password" class="form-label">Password</label>
                            <div class="input-wrapper">
                                <i class="bi bi-lock"></i>
                                <input asp-for="LoginRequest.Password"
                                       type="password"
                                       class="form-control-custom"
                                       placeholder="Enter password"
                                       autocomplete="current-password" />
                            </div>
                        </div>

                        <button type="submit" class="login-button">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Sign In
                        </button>

                    </form>

                </div>

            </div>
        </div>

    </div>

</body>
</html>


