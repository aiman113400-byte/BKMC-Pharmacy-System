
@page
@model BKMC.Pharmacy.Web.Pages.Dispensings.CreateModel

@{
    ViewData["Title"] = "Create Dispensing";
}
<style>
    /* Theme Colors */
    .bg-teal { background-color: #0f766e !important; }
    .text-teal { color: #0f766e !important; }
    .btn-teal { background-color: #0f766e; color: white; border: none; }
    .btn-teal:hover { background-color: #0d5c56; color: white; }
    
    /* Card Styling */
    .card-custom {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        background-color: #ffffff;
    }
    .card-header-custom {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.25rem 1.5rem;
    }
    
    /* Form Controls */
    .form-label { font-size: 0.875rem; font-weight: 600; color: #475569; }
    .form-control, .form-select {
        border-radius: 0.5rem;
        border-color: #cbd5e1;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }
</style>


<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">Create Dispensing</h1>
            <p class="text-muted mb-0">
                Dispense medicine to a patient
            </p>
        </div>

        <a asp-page="Index"
           class="btn btn-outline-secondary">
            Back to List
        </a>

    </div>


    <!-- ================= SUCCESS ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- ================= VALIDATION ================= -->

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    <!-- ================= FORM ================= -->

    <form method="post">

        <!-- ================= DISPENSING DETAILS ================= -->

        <div class="card mb-4 shadow-sm">

            <div class="card-body">

                <h4 class="mb-3">
                    Dispensing Details
                </h4>

                <div class="row g-3">

                    <!-- Patient -->

                    <div class="col-md-3">

                        <label asp-for="Input.PatientId"
                               class="form-label">

                            Patient
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="Input.PatientId"
                                class="form-select">

                            <option value="0">
                                -- Select Patient --
                            </option>

                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.Id">
                                    @patient.MRNumber - @patient.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Input.PatientId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Dispensing Date -->

                    <div class="col-md-3">

                        <label asp-for="Input.DispensingDate"
                               class="form-label">

                            Dispensing Date

                        </label>

                        <input asp-for="Input.DispensingDate"
                               type="datetime-local"
                               class="form-control"
                               value="@Model.Input.DispensingDate.ToString("yyyy-MM-ddTHH:mm")" />

                        <span asp-validation-for="Input.DispensingDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Prescription -->

                    <div class="col-md-3">

                        <label asp-for="Input.PrescriptionNumber"
                               class="form-label">

                            Prescription Number

                        </label>

                        <input asp-for="Input.PrescriptionNumber"
                               class="form-control"
                               placeholder="e.g. RX-2026-001" />

                    </div>


                    <!-- Remarks -->

                    <div class="col-md-3">

                        <label asp-for="Input.Remarks"
                               class="form-label">

                            Remarks

                        </label>

                        <input asp-for="Input.Remarks"
                               class="form-control"
                               placeholder="Optional remarks" />

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= MEDICINES ================= -->

        <div class="card mb-4 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h4 class="mb-0">
                        Medicines
                    </h4>

                    <button type="button"
                            id="addItemBtn"
                            class="btn btn-sm btn-outline-teal">

                        + Add Medicine

                    </button>

                </div>


                <div id="itemsContainer">

                    @for (int i = 0;
                          i < Model.Input.Items.Count;
                          i++)
                    {
                        <div class="row g-2 mb-2 item-row">

                            <!-- Medicine -->

                            <div class="col-md-5">

                                <select asp-for="Input.Items[i].MedicineId"
                                        class="form-select">

                                    <option value="0">
                                        -- Select Medicine --
                                    </option>

                                    @foreach (var medicine in Model.Medicines)
                                    {
                                        <option value="@medicine.Id">
                                            @medicine.Name
                                        </option>
                                    }

                                </select>

                            </div>


                            <!-- Quantity -->

                            <div class="col-md-2">

                                <input asp-for="Input.Items[i].Quantity"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control"
                                       placeholder="Quantity" />

                            </div>


                            <!-- Dosage -->

                            <div class="col-md-4">

                                <input asp-for="Input.Items[i].Dosage"
                                       class="form-control"
                                       placeholder="Dosage e.g. 1+0+1" />

                            </div>


                            <!-- Remove -->

                            <div class="col-md-1">

                                <button type="button"
                                        class="btn btn-outline-danger removeItemBtn">

                                    ✕

                                </button>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ================= SAVE ================= -->

        <div class="d-flex gap-2 mb-5">

            <button type="submit"
                    class="btn btn-teal">

                Save Dispensing

            </button>

            <a asp-page="Index"
               class="btn btn-outline-secondary">

                Cancel

            </a>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/dispensing-create.js"></script>

}