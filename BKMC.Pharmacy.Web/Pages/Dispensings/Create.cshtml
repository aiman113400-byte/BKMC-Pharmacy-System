@page
@model BKMC.Pharmacy.Web.Pages.Dispensings.CreateModel

@{
    ViewData["Title"] = "Create Dispensing";
}

<style>
    /* Professional Pharmacy Theme */
    :root {
        --teal-primary: #0f766e;
        --teal-hover: #0d5c56;
        --border-color: #e2e8f0;
    }

    body {
        background-color: #f8fafc; /* Soft grey background for the page */
    }

    .text-teal { color: var(--teal-primary) !important; }
    
    /* Buttons */
    .btn-teal {
        background-color: var(--teal-primary);
        color: white;
        border: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .btn-teal:hover {
        background-color: var(--teal-hover);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(15, 118, 110, 0.3);
    }
    .btn-outline-teal {
        color: var(--teal-primary);
        border: 1px solid var(--teal-primary);
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .btn-outline-teal:hover {
        background-color: var(--teal-primary);
        color: white;
    }

    /* Card Styling - Exact match with the List Page */
    .card-custom {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }
    .card-header-custom {
        background-color: #ffffff;
        border-bottom: 1px solid var(--border-color);
        padding: 1.25rem 1.5rem;
    }
    
    /* Form Controls - Ensuring perfect alignment */
    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem; /* Uniform margin for all labels */
    }
    
    .form-control, .form-select {
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.625rem 0.875rem; /* Same padding for select and input */
        font-size: 0.875rem;
        height: 42px; /* Force same height for both */
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: var(--teal-primary);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }

    /* Medicine Row Styling */
    .item-row {
        background-color: #f8fafc;
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1rem;
        transition: all 0.2s ease;
    }
    .item-row:hover {
        border-color: #cbd5e1;
        background-color: #ffffff;
    }
    
    /* Delete Button */
    .btn-remove {
        border: 1px solid #fecaca;
        color: #ef4444;
        background: white;
        border-radius: 0.5rem;
        height: 42px;
        transition: all 0.2s;
    }
    .btn-remove:hover {
        background-color: #fef2f2;
        color: #dc2626;
        border-color: #fca5a5;
    }
</style>


<div class="container py-5">

    <!-- ================= HEADER ================= -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">Create Dispensing</h2>
            <p class="text-muted mb-0 small">Dispense medicine to a patient</p>
        </div>

        <a asp-page="Index" class="btn btn-teal px-4 py-2 d-inline-flex align-items-center gap-2" style="border-radius: 0.5rem;">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>


    <!-- ================= SUCCESS ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm" style="border-radius: 0.75rem;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }


    <!-- ================= VALIDATION ================= -->
    <div asp-validation-summary="All" class="text-danger mb-3 fw-medium"></div>


    <!-- ================= FORM ================= -->
    <form method="post">

        <!-- ================= DISPENSING DETAILS ================= -->
        <div class="card-custom">
            <div class="card-header-custom">
                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.1rem;">Dispensing Details</h5>
            </div>

            <div class="card-body p-4">
                <!-- align-items-end ensures inputs align beautifully even if labels wrap -->
                <div class="row g-4 align-items-end">

                    <!-- Patient -->
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <label asp-for="Input.PatientId" class="form-label">
                             Patient @*<span class="text-danger"></span> *@
                        </label>
                        <select asp-for="Input.PatientId" class="form-select">
                            <option value="0">-- Select Patient --</option>
                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.Id">@patient.MRNumber - @patient.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.PatientId" class="text-danger small"></span>
                    </div>

                    <!-- Dispensing Date -->
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <label asp-for="Input.DispensingDate" class="form-label">Dispensing Date</label>
                        <input asp-for="Input.DispensingDate" type="datetime-local" class="form-control" 
                               value="@Model.Input.DispensingDate.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Input.DispensingDate" class="text-danger small"></span>
                    </div>

                    <!-- Prescription -->
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <label asp-for="Input.PrescriptionNumber" class="form-label">Prescription Number</label>
                        <input asp-for="Input.PrescriptionNumber" class="form-control" placeholder="e.g. RX-2026-001" />
                    </div>

                    <!-- Remarks -->
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <label asp-for="Input.Remarks" class="form-label">Remarks</label>
                        <input asp-for="Input.Remarks" class="form-control" placeholder="Optional remarks" />
                    </div>

                </div>
            </div>
        </div>


        <!-- ================= MEDICINES ================= -->
        <div class="card-custom">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.1rem;">Medicines</h5>
                <button type="button" id="addItemBtn" class="btn btn-sm btn-outline-teal px-3 py-2 d-inline-flex align-items-center gap-2" style="border-radius: 0.375rem;">
                    <i class="bi bi-plus-lg"></i> Add Medicine
                </button>
            </div>

            <div class="card-body p-4">
                <div id="itemsContainer">
                    @for (int i = 0; i < Model.Input.Items.Count; i++)
                    {
                        <div class="row g-3 align-items-center item-row">
                            
                            <!-- Medicine -->
                            <div class="col-xl-5 col-lg-5 col-md-12">
                                <select asp-for="Input.Items[i].MedicineId" class="form-select">
                                    <option value="0">-- Select Medicine --</option>
                                    @foreach (var medicine in Model.Medicines)
                                    {
                                        <option value="@medicine.Id">@medicine.Name</option>
                                    }
                                </select>
                            </div>

                            <!-- Quantity -->
                            <div class="col-xl-2 col-lg-2 col-md-4">
                                <input asp-for="Input.Items[i].Quantity" type="number" step="0.01" min="0.01" class="form-control" placeholder="Quantity" />
                            </div>

                            <!-- Dosage -->
                            <div class="col-xl-4 col-lg-4 col-md-6">
                                <input asp-for="Input.Items[i].Dosage" class="form-control" placeholder="Dosage e.g. 1+0+1" />
                            </div>

                            <!-- Remove -->
                            <div class="col-xl-1 col-lg-1 col-md-2 text-end">
                                <button type="button" class="btn btn-remove w-100 removeItemBtn d-flex justify-content-center align-items-center">
                                    ✕
                                </button>
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>


        <!-- ================= SAVE ================= -->
        <div class="d-flex gap-3 mb-5">
            <button type="submit" class="btn btn-teal px-4 py-2" style="border-radius: 0.5rem;">
                Save Dispensing
            </button>
            <a asp-page="Index" class="btn btn-light border px-4 py-2 text-secondary" style="border-radius: 0.5rem; font-weight: 500;">
                Cancel
            </a>
        </div>

    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dispensing-create.js"></script>
}



