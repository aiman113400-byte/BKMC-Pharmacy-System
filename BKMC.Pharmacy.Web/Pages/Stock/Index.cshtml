@page
@model BKMC.Pharmacy.Web.Pages.Stock.IndexModel
@using BKMC.Pharmacy.Web.Models.Stock

@{
    ViewData["Title"] = "Stock Management";
}

<style>
    /* ================= THEME ================= */
    :root {
        --teal-50: #f0fdfa;
        --teal-100: #ccfbf1;
        --teal-600: #0f766e;
        --teal-700: #0d5c56;
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-400: #94a3b8;
        --slate-500: #64748b;
        --slate-700: #334155;
    }

    .card-custom {
        border: 1px solid var(--slate-200) !important;
        border-radius: 12px !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
        overflow: hidden !important;
        background: #ffffff !important;
    }

    /* ================= FILTER PANEL ================= */
    .filter-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--slate-700);
        margin-bottom: 0.35rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .filter-input, .filter-select {
        border-radius: 8px !important;
        border: 1px solid var(--slate-200) !important;
        padding: 0.5rem 0.85rem !important;
        font-size: 0.85rem !important;
        height: 42px;
        transition: all 0.2s !important;
    }
    .filter-input:focus, .filter-select:focus {
        border-color: var(--teal-600) !important;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12) !important;
        outline: none !important;
    }

    .btn-search {
        background: var(--teal-600) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        font-weight: 500 !important;
        font-size: 0.85rem !important;
        padding: 0 1.25rem !important;
        height: 42px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: background 0.2s !important;
        white-space: nowrap;
    }
    .btn-search:hover {
        background: var(--teal-700) !important;
    }

    .btn-clear {
        background: #ffffff !important;
        border: 1px solid var(--slate-200) !important;
        color: var(--slate-700) !important;
        border-radius: 8px !important;
        font-weight: 500 !important;
        font-size: 0.85rem !important;
        padding: 0 1.1rem !important;
        height: 42px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.15s !important;
        text-decoration: none !important;
        white-space: nowrap;
    }
    .btn-clear:hover {
        background: var(--slate-50) !important;
        border-color: var(--slate-400) !important;
        color: var(--slate-700) !important;
    }

    /* ================= COMPACT HEADER ================= */
    .compact-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1.25rem;
        background: var(--teal-50);
        border-bottom: 1px solid var(--slate-200);
        gap: 1rem;
        flex-wrap: wrap;
    }
    .compact-header-left {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }
    .compact-header-icon {
        width: 32px;
        height: 32px;
        background: #ffffff;
        border: 1px solid var(--slate-200);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--teal-600);
        font-size: 0.9rem;
        flex-shrink: 0;
    }
    .compact-header-title {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--teal-600);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
        line-height: 1.2;
    }

    .count-pill {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--teal-100);
        color: var(--teal-600);
    }

    /* ================= TABLE ================= */
    .table-aesthetic {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }
    .table-aesthetic thead th {
        background: var(--slate-50);
        color: var(--slate-500);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--slate-200);
        white-space: nowrap;
    }
    .table-aesthetic tbody tr {
        border-bottom: 1px solid var(--slate-100);
        transition: background 0.15s;
    }
    .table-aesthetic tbody tr:last-child {
        border-bottom: none;
    }
    .table-aesthetic tbody tr:hover {
        background: var(--teal-50);
    }
    .table-aesthetic tbody td {
        padding: 0.9rem 1.25rem;
        font-size: 0.85rem;
        color: var(--slate-700);
        vertical-align: middle;
    }
    .cell-id {
        color: var(--slate-400) !important;
        font-weight: 600;
        font-size: 0.78rem !important;
    }
    .cell-medicine {
        font-weight: 700;
        color: #0f172a !important;
        font-size: 0.88rem !important;
        margin-bottom: 0.1rem;
    }
    .cell-medicine-id {
        color: var(--slate-400);
        font-size: 0.72rem;
        font-weight: 500;
    }
    .cell-qty {
        font-weight: 700;
        color: #0f172a;
        font-size: 0.9rem !important;
    }

    /* ================= BADGES ================= */
    .pill-batch {
        background: var(--teal-100);
        color: var(--teal-600);
        font-family: 'SF Mono', Menlo, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.3rem 0.7rem;
        border-radius: 6px;
        display: inline-block;
    }
    .pill-location {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
    }
    .pill-location i {
        font-size: 0.7rem;
    }
    .loc-warehouse {
        background: var(--teal-100);
        color: var(--teal-600);
    }
    .loc-pharmacy {
        background: #d1fae5;
        color: #065f46;
    }
    .loc-other {
        background: var(--slate-100);
        color: var(--slate-700);
    }

    /* ================= VIEW BUTTON ================= */
    .btn-view {
        background: #ffffff !important;
        border: 1px solid var(--slate-200) !important;
        color: var(--teal-600) !important;
        font-weight: 500 !important;
        font-size: 0.78rem !important;
        padding: 0.35rem 0.85rem !important;
        border-radius: 8px !important;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: all 0.15s !important;
        text-decoration: none !important;
        white-space: nowrap;
    }
    .btn-view:hover {
        background: var(--teal-600) !important;
        color: #ffffff !important;
        border-color: var(--teal-600) !important;
    }

    /* ================= EMPTY STATE ================= */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--slate-400);
    }
    .empty-state-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--slate-50);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: var(--slate-400);
        margin-bottom: 0.75rem;
    }
    .empty-state-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--slate-700);
        margin-bottom: 0.25rem;
    }
    .empty-state-text {
        font-size: 0.78rem;
        color: var(--slate-500);
        margin: 0;
    }

    /* ================= PAGE HEADER ================= */
    .page-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 0.15rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .page-subtitle {
        font-size: 0.8rem;
        color: var(--slate-500);
        margin: 0;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1400px;">

    <!-- ================= PAGE HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="page-title">
                <i class="bi bi-box-seam" style="color: var(--teal-600);"></i>
                Stock Management
            </h2>
            <p class="page-subtitle">View and manage current medicine stock.</p>
        </div>
    </div>

    <!-- ================= ERROR ================= -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center mb-3" style="border-radius: 10px; border: none; font-size: 0.85rem;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Model.ErrorMessage
        </div>
    }

    <!-- ================= FILTER / SEARCH CARD ================= -->
    <div class="card-custom mb-3">
        <div class="p-3">
            <!-- ✅ Form ko ID diya, ab JavaScript handle karega -->
            <form id="stockFilterForm" onsubmit="return false;">

                <div class="row g-2 align-items-end">

                    <!-- Search Input -->
                    <div class="col-md-5">
                        <label class="filter-label">Search Stock</label>
                        <input type="text"
                               id="searchInput"
                               value="@Model.SearchTerm"
                               class="form-control filter-input"
                               placeholder="Search medicine or batch number..."
                               autocomplete="off" />
                    </div>

                    <!-- Location Dropdown -->
                    <div class="col-md-3">
                        <label class="filter-label">Location</label>
                        <select id="locationSelect" class="form-select filter-select">
                            <option value="">All Locations</option>
                            @foreach (var loc in Enum.GetValues(typeof(BKMC.Pharmacy.Web.Models.Stock.StockLocation)))
                            {
                                var isSelected = Model.SelectedLocation != null && Model.SelectedLocation.ToString() == loc.ToString();
                                <option value="@loc" selected="@isSelected">@loc</option>
                            }
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-4 d-flex gap-2">
                        <button type="button" id="searchBtn" class="btn-search">
                            <i class="bi bi-search"></i>
                            Search
                        </button>
                        <button type="button" id="clearBtn" class="btn-clear">
                            <i class="bi bi-arrow-clockwise"></i>
                            Clear
                        </button>
                    </div>

                </div>

            </form>
        </div>
    </div>

    <!-- ================= STOCK TABLE CARD ================= -->
    <div class="card-custom">
        <div class="compact-header">
            <div class="compact-header-left">
                <div class="compact-header-icon">
                    <i class="bi bi-boxes"></i>
                </div>
                <p class="compact-header-title">Current Stock</p>
            </div>
            <span class="count-pill">
                <i class="bi bi-hash"></i>
                @Model.Stocks.Count record(s)
            </span>
        </div>

        @if (Model.Stocks.Any())
        {
            <div class="table-responsive">
                <table class="table-aesthetic">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Medicine</th>
                            <th>Batch</th>
                            <th>Location</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end" style="width: 110px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rowNum = 1;
                        }
                        @foreach (var stock in Model.Stocks)
                        {
                            <tr>
                                <td class="cell-id">@rowNum</td>

                                <td>
                                    <div class="cell-medicine">@stock.MedicineName</div>
                                    <div class="cell-medicine-id">Medicine ID: @stock.MedicineId</div>
                                </td>

                                <td>
                                    <span class="pill-batch">@stock.BatchNumber</span>
                                </td>

                                <td>
                                    @{
                                        var locClass = stock.Location.ToString() == "Warehouse" ? "loc-warehouse"
                                                     : stock.Location.ToString() == "Pharmacy" ? "loc-pharmacy"
                                                     : "loc-other";
                                        var locIcon = stock.Location.ToString() == "Pharmacy" ? "bi-shop" : "bi-building";
                                    }
                                    <span class="pill-location @locClass">
                                        <i class="bi @locIcon"></i>
                                        @stock.Location
                                    </span>
                                </td>

                                <td class="text-end cell-qty">@stock.Quantity.ToString("N2")</td>

                                <td class="text-end">
                                    <a asp-page="./Details"
                                       asp-route-id="@stock.Id"
                                       class="btn-view">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </a>
                                </td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-inbox"></i></div>
                <div class="empty-state-title">No Stock Found</div>
                <p class="empty-state-text">Try changing the search term or location filter.</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput    = document.getElementById("searchInput");
            const locationSelect = document.getElementById("locationSelect");
            const searchBtn      = document.getElementById("searchBtn");
            const clearBtn       = document.getElementById("clearBtn");

            // ✅ Search Function - Direct URL build karke navigate karega
            function performSearch() {
                const searchTerm = searchInput ? searchInput.value.trim() : "";
                const location   = locationSelect ? locationSelect.value : "";

                const params = new URLSearchParams();
                if (searchTerm) params.set("searchTerm", searchTerm);
                if (location)   params.set("selectedLocation", location);

                const queryString = params.toString();
                const baseUrl = window.location.pathname;

                // Navigate with query string
                window.location.href = queryString ? `${baseUrl}?${queryString}` : baseUrl;
            }

            // ✅ Search button click
            if (searchBtn) {
                searchBtn.addEventListener("click", performSearch);
            }

            // ✅ Enter key on search input
            if (searchInput) {
                searchInput.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        performSearch();
                    }
                    if (e.key === "Escape") {
                        this.value = "";
                    }
                });
            }

            // ✅ Location dropdown - auto submit on change
            if (locationSelect) {
                locationSelect.addEventListener("change", performSearch);
            }

            // ✅ Clear button - reset all filters
            if (clearBtn) {
                clearBtn.addEventListener("click", function () {
                    if (searchInput)    searchInput.value = "";
                    if (locationSelect) locationSelect.value = "";
                    window.location.href = window.location.pathname;
                });
            }
        });
    </script>
}

