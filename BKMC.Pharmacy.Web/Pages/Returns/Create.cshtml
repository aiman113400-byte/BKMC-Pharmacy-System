@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // =========================================================
        // Data received from server
        // =========================================================

        const dispensings =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.Dispensings
                )
            );


        // =========================================================
        // Elements
        // =========================================================

        const patientSelect =
            document.getElementById("patientSelect");

        const dispensingSelect =
            document.getElementById("dispensingSelect");

        const itemsBody =
            document.getElementById("dispensingItemsBody");

        const itemsContainer =
            document.getElementById("dispensingItemsContainer");

        const noDispensingMessage =
            document.getElementById("noDispensingMessage");


        // =========================================================
        // Save original dispensing options
        // =========================================================

        const allDispensingOptions =
            Array.from(
                dispensingSelect.options
            ).slice(1);


        // =========================================================
        // Reset dispensing and items
        // =========================================================

        function resetDispensing()
        {
            dispensingSelect.innerHTML = `
                <option value="">
                    -- Select Dispensing --
                </option>
            `;

            itemsBody.innerHTML = "";

            itemsContainer.style.display = "none";

            noDispensingMessage.style.display = "block";
        }


        // =========================================================
        // Patient change
        // =========================================================

        patientSelect.addEventListener(
            "change",
            function ()
            {
                resetDispensing();

                const patientId =
                    this.value;


                if (!patientId ||
                    patientId === "0")
                {
                    return;
                }


                allDispensingOptions.forEach(
                    function (option)
                    {
                        if (
                            option.dataset.patientId ===
                            patientId
                        )
                        {
                            dispensingSelect.appendChild(
                                option.cloneNode(true)
                            );
                        }
                    }
                );


                // Check if dispensing exists
                if (dispensingSelect.options.length === 1)
                {
                    const option =
                        document.createElement("option");

                    option.value = "";

                    option.textContent =
                        "-- No Dispensing Found --";

                    dispensingSelect.appendChild(option);
                }
            }
        );


        // =========================================================
        // Dispensing change
        // =========================================================

        dispensingSelect.addEventListener(
            "change",
            function ()
            {
                loadDispensingItems();
            }
        );


        // =========================================================
        // Load dispensing items
        // =========================================================

        function loadDispensingItems()
        {
            itemsBody.innerHTML = "";


            const dispensingId =
                parseInt(
                    dispensingSelect.value
                );


            if (!dispensingId)
            {
                itemsContainer.style.display = "none";

                noDispensingMessage.style.display = "block";

                return;
            }


            const dispensing =
                dispensings.find(
                    function (x)
                    {
                        return Number(x.id) ===
                               Number(dispensingId);
                    }
                );


            if (
                !dispensing ||
                !dispensing.items ||
                dispensing.items.length === 0
            )
            {
                itemsContainer.style.display = "none";

                noDispensingMessage.style.display = "block";

                return;
            }


            noDispensingMessage.style.display = "none";

            itemsContainer.style.display = "block";


            dispensing.items.forEach(
                function (item, index)
                {
                    const row =
                        document.createElement("tr");


                    row.innerHTML = `
                        <td>
                            ${item.medicineName}
                        </td>

