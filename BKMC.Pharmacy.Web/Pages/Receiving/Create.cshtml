        addItemBtn.addEventListener("click", function ()
        {
            const index =
                container.querySelectorAll(".receiving-item").length;

            container.insertAdjacentHTML(
                "beforeend",
                createItem(index)
            );
        });


        container.addEventListener("click", function (event)
        {
            const button =
                event.target.closest(".remove-item");

            if (!button)
                return;

            const items =
                container.querySelectorAll(".receiving-item");

            if (items.length <= 1)
            {
                return;
            }

            button.closest(".receiving-item").remove();
        });

    </script>
