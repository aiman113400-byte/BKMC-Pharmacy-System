@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const medicines = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(Model.Medicines)
        );

        const container =
            document.getElementById("receivingItems");

        const addItemBtn =
            document.getElementById("addItemBtn");


        function createMedicineOptions()
        {
            let options =
                '<option value="0">Select Medicine</option>';

            medicines.forEach(function (medicine)
            {
                options += `
                    <option value="${medicine.id}">
                        ${medicine.name} (${medicine.medicineCode})
                    </option>`;
            });

            return options;
        }


        function createItem(index)
        {
            return `
                <div class="receiving-item border rounded p-3 mb-3">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label class="form-label">
                                Medicine
                            </label>

                            <select
                                name="Receiving.Items[${index}].MedicineId"
                                class="form-select">

                                ${createMedicineOptions()}

                            </select>

                        </div>


                        <div class="col-md-4">

                            <label class="form-label">
                                Batch Number
                            </label>

