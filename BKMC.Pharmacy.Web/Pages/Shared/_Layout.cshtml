@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    
    string IsActive(string pagePath) =>
        currentPage.Equals(pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BKMC Pharmacy</title>

    <meta name="description"
          content="BKMC Pharmacy Inventory & Patient Billing System" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <!-- ✅ NAYI FILE: Dark Mode Theme -->
    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)

    <!-- ✅ ANTI-FLASH: Theme ko page load se pehle set karo -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    </head>

<body>


    <!-- Sidebar -->
<aside id="sidebar" class="sidebar">

    <!-- Brand -->
    <div class="sidebar__brand">
        <div class="sidebar__brand-icon">
            <i class="bi bi-capsule"></i>
        </div>
        <div class="sidebar__brand-text">
            <span class="sidebar__brand-title">BKMC Pharmacy</span>
            <span class="sidebar__brand-subtitle">Management</span>
        </div>
    </div>

    

    <!-- Navigation -->
 <nav class="sidebar__nav">

    <div class="sidebar__section">Overview</div>
    <a asp-page="/Index" class="sidebar__link @IsActive("/Index")">
        <i class="bi bi-grid"></i> Dashboard
    </a>

    <div class="sidebar__section">Dispensing</div>
    <a asp-page="/Patients/Index" class="sidebar__link @IsActive("/Patients/Index")">
        <i class="bi bi-person"></i> Patients
    </a>
    <a asp-page="/Dispensings/Index" class="sidebar__link @IsActive("/Dispensings/Index")">
        <i class="bi bi-capsule"></i> Dispensing
    </a>
    <a asp-page="/Bill/Index" class="sidebar__link @IsActive("/Bill/Index")">
        <i class="bi bi-capsule"></i> Bills
    </a>
     <a asp-page="/Returns/Index" class="sidebar__link @IsActive("/Returns/Index")">
        <i class="bi bi-capsule"></i> Returns
    </a>

    <div class="sidebar__section">Inventory</div>
    <a asp-page="/Medicines/Index" class="sidebar__link @IsActive("/Medicines/Index")">
        <i class="bi bi-box"></i> Medicine Master
    </a>
    <a asp-page="/Receiving/Index" class="sidebar__link @IsActive("/Receiving/Index")">
        <i class="bi bi-download"></i>Stock Receiving
    </a>
    <a asp-page="/Batches/Index" class="sidebar__link @IsActive("/Batches/Index")">
        <i class="bi bi-boxes"></i> Batches & FEFO
    </a>
    <a asp-page="/Stock/Index" class="sidebar__link @IsActive("/Stock/Index")">
        <i class="bi bi-stack"></i> Stock
    </a>
    <a asp-page="/StockTransfers/Index" class="sidebar__link @IsActive("/StockTransfers/Index")">
        <i class="bi bi-arrow-left-right"></i> Stock Transfer
    </a>
    <a asp-page="/StockAdjustment/Create" class="sidebar__link @IsActive("/StockAdjustment/Create")">
    <i class="bi bi-sliders"></i> Stock Adjustment
</a>

</nav>

    <!-- Footer -->
    <div class="sidebar__footer">
        <div class="sidebar__status">
            <div class="sidebar__status-dot"></div>
            <div class="sidebar__status-text">
                <span class="sidebar__status-title">System Online</span>
                <span class="sidebar__status-sub">BKMC Pharmacy</span>
            </div>
        </div>
    </div>

</aside>

    <!-- Main Application -->
     <div class="app-wrapper">

        <!-- Top Navbar -->
        <header class="top-navbar">

            <div class="navbar-left">

                <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle"
                        aria-label="Open navigation">

                    <i class="bi bi-list"></i>

                </button>

                <div class="page-heading">

                    <span class="page-heading-label">
                        Pharmacy Management
                    </span>

                    <h1>
                        @ViewData["Title"]
                    </h1>

                </div>

            </div>


            <div class="navbar-right">

                <!-- Search -->
                <div class="global-search">

                    <i class="bi bi-search"></i>

                    <input type="search"
                           placeholder="Search..."
                           aria-label="Global search" />

                    <span class="search-shortcut">
                        Ctrl K
                    </span>

                </div>

                <!-- ✅ DARK MODE TOGGLE BUTTON (NAYA) -->
                <button type="button"
                        id="themeToggle"
                        class="navbar-icon-button"
                        title="Toggle dark mode"
                        aria-label="Toggle dark mode">

                    <i class="bi bi-moon" id="themeIcon"></i>

                </button>

                <!-- Notifications -->
                <button type="button"
                        class="navbar-icon-button"
                        title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-dot"></span>

                </button>


                <!-- User -->
                <div class="user-profile">

                    <div class="user-avatar">
                        AK
                    </div>

                    <div class="user-info">

                        <span class="user-name">
                            Admin User
                        </span>

                        <span class="user-role">
                            Administrator
                        </span>

                    </div>

                    <i class="bi bi-chevron-down user-chevron"></i>

                </div>

            </div>

        </header>


        <!-- Page Content -->
        <main class="main-content">

            <div class="content-container">

                @RenderBody()

            </div>

        </main>


        <!-- Footer -->
        <footer class="app-footer">

            <span>
                © @DateTime.Now.Year BKMC Pharmacy
            </span>

            <span>
                Inventory & Patient Billing System
            </span>

        </footer>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/layout.js"
            asp-append-version="true"></script>

    <!-- ✅ NAYI FILE: Dark Mode Toggle Logic -->
    <script src="~/js/theme.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
