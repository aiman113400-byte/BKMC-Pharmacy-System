@page
@model BKMC.Pharmacy.Web.Pages.StockAdjustment.CreateModel

@{
    ViewData["Title"] = "Stock Adjustment";
}

<div class="container py-4">
    <!-- Row justify-content-center se form center mein aayega -->
    <div class="row justify-content-center">
        <!-- col-md-8 aur col-lg-6 se form ki width choti ho jayegi -->
        <div class="col-md-8 col-lg-6">

            <div class="mb-4 text-center">
                <h2>Stock Adjustment</h2>
                <p class="text-muted mb-0">
                    Adjust the current stock quantity for a specific medicine,
                    batch, and location.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <!-- Card Wrapper (Design ko chota aur clean karne ke liye) -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <form method="post">

                        <!-- Medicine -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Medicine</label>
                            <select class="form-select" asp-for="Adjustment.MedicineId" id="medicineSelect">
                                <option value="0">Select Medicine</option>
                                @foreach (var medicine in Model.Medicines)
                                {
                                    <option value="@medicine.Id">
                                        @medicine.Name
                                        @if (!string.IsNullOrWhiteSpace(medicine.Strength))
                                        {
                                            <text> - @medicine.Strength</text>
                                        }
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Adjustment.MedicineId" class="text-danger"></span>
                        </div>

                        <!-- Batch -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Batch</label>
                            <select class="form-select" asp-for="Adjustment.BatchId" id="batchSelect">
                                <option value="0">Select Batch</option>
                            </select>
                            <span asp-validation-for="Adjustment.BatchId" class="text-danger"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Location</label>
                            <select class="form-select" asp-for="Adjustment.Location">
                                <option value="1">Warehouse</option>
                                <option value="2">Pharmacy</option>
                            </select>
                        </div>

                        <!-- Current Quantity -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Quantity</label>
                            <input type="text" class="form-control" id="currentQuantity" value="0" readonly style="background-color: #f9fafb;" />
                        </div>

                        <!-- New Quantity -->
                        <div class="mb-3">
                            <label asp-for="Adjustment.NewQuantity" class="form-label fw-semibold">
                                New Quantity
                            </label>
                            <input asp-for="Adjustment.NewQuantity" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="Adjustment.NewQuantity" class="text-danger"></span>
                        </div>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label asp-for="Adjustment.Reason" class="form-label fw-semibold">
                                Reason
                            </label>
                            <textarea asp-for="Adjustment.Reason" class="form-control" rows="3" maxlength="500"></textarea>
                            <span asp-validation-for="Adjustment.Reason" class="text-danger"></span>
                        </div>

                        <!-- Adjustment Date -->
                        <div class="mb-3">
                            <label asp-for="Adjustment.AdjustmentDate" class="form-label fw-semibold">
                                Adjustment Date
                            </label>
                            <input asp-for="Adjustment.AdjustmentDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Adjustment.AdjustmentDate" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2 justify-content-end border-top pt-3 mt-4">
                            <a asp-page="/Stock/Index" class="btn btn-light border">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Adjust Stock
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const medicineSelect =
                document.getElementById("medicineSelect");

            const batchSelect =
                document.getElementById("batchSelect");

            if (!medicineSelect || !batchSelect) {
                console.error(
                    "Medicine or Batch select was not found."
                );
                return;
            }

            medicineSelect.addEventListener(
                "change",
                async function() {

                    const medicineId = this.value;

                    batchSelect.innerHTML =
                        '<option value="0">Loading batches...</option>';

                    if (!medicineId || medicineId === "0") {

                        batchSelect.innerHTML =
                            '<option value="0">Select Batch</option>';

                        return;
                    }

                    try {

                        const response = await fetch(
                            `?handler=Batches&medicineId=${encodeURIComponent(medicineId)}`
                        );

                        if (!response.ok) {
                            throw new Error(
                                `Failed to load batches. Status: ${response.status}`
                            );
                        }

                        const batches =
                            await response.json();

                        console.log(
                            "Batches received:",
                            batches
                        );

                        batchSelect.innerHTML =
                            '<option value="0">Select Batch</option>';

                        if (!Array.isArray(batches) ||
                            batches.length === 0) {

                            batchSelect.innerHTML =
                                '<option value="0">No batches available</option>';

                            return;
                        }

                        batches.forEach(function(batch) {

                            const option =
                                document.createElement("option");

                            const batchId =
                                batch.id ?? batch.Id;

                            const batchNumber =
                                batch.batchNumber ??
                                batch.BatchNumber;

                            const expiryDate =
                                batch.expiryDate ??
                                batch.ExpiryDate;

                            option.value = batchId;

                            option.textContent =
                                `${batchNumber} - Exp: ${new Date(expiryDate)
                                    .toLocaleDateString()
                                }`;

                            batchSelect.appendChild(option);

                        });

                    }
                    catch (error) {

                        console.error(
                            "Error loading batches:",
                            error
                        );

                        batchSelect.innerHTML =
                            '<option value="0">Unable to load batches</option>';
                    }
                }
            );
        });
    </script>
}


