</style>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* ===================================================== */
            /* EXISTING INVENTORY OVERVIEW CHART                     */
            /* ===================================================== */

            const canvas =
                document.getElementById('inventoryChart');

            if (canvas) {

                const ctx =
                    canvas.getContext('2d');

                const tealColor =
                    '#0f766e';

                const tealSoft =
                    'rgba(15, 118, 110, 0.12)';

                const amberColor =
                    '#f59e0b';

                const amberSoft =
                    'rgba(245, 158, 11, 0.10)';

                const redColor =
                    '#ef4444';

                const redSoft =
                    'rgba(239, 68, 68, 0.08)';


                new Chart(ctx, {

                    type: 'line',

                    data: {

                        labels: [
                            'May',
                            'Jun',
                            'Jul',
                            'Aug',
                            'Sep',
                            'Oct'
                        ],

                        datasets: [

                            {
                                label: 'Total Stock',

                                data: [
                                    120,
                                    145,
                                    138,
                                    165,
                                    172,
                                    182
                                ],

                                borderColor: tealColor,

                                backgroundColor: tealSoft,

                                borderWidth: 2.5,

                                tension: 0.4,

                                fill: true,

                                pointBackgroundColor: '#ffffff',

                                pointBorderColor: tealColor,

                                pointBorderWidth: 2,

                                pointRadius: 4,

                                pointHoverRadius: 6
                            },

                            {
                                label: 'Low Stock',

                                data: [
                                    12,
                                    9,
                                    11,
                                    7,
                                    4,
                                    2
                                ],

                                borderColor: amberColor,

                                backgroundColor: amberSoft,

                                borderWidth: 2.5,

                                tension: 0.4,

                                fill: true,

                                pointBackgroundColor: '#ffffff',

                                pointBorderColor: amberColor,

                                pointBorderWidth: 2,

                                pointRadius: 4,

                                pointHoverRadius: 6
                            },

                            {
                                label: 'Out of Stock',

                                data: [
                                    5,
                                    4,
                                    6,
                                    3,
                                    2,
                                    1
                                ],

                                borderColor: redColor,

                                backgroundColor: redSoft,

                                borderWidth: 2.5,

                                tension: 0.4,

                                fill: true,

                                pointBackgroundColor: '#ffffff',

                                pointBorderColor: redColor,

                                pointBorderWidth: 2,

                                pointRadius: 4,

                                pointHoverRadius: 6
                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        interaction: {

                            intersect: false,

                            mode: 'index'
                        },

                        plugins: {

                            legend: {

                                position: 'top',

                                align: 'end',

                                labels: {

                                    usePointStyle: true,

                                    pointStyle: 'circle',

                                    boxWidth: 8,

                                    boxHeight: 8,

                                    padding: 16,

                                    font: {

                                        family:
                                            'system-ui, -apple-system, sans-serif',

                                        size: 12,

                                        weight: '500'
                                    },

                                    color: '#475569'
                                }

                            },

                            tooltip: {

                                backgroundColor:
                                    '#1e293b',

                                padding: 12,

                                cornerRadius: 8,

                                titleFont: {

                                    size: 13,

                                    weight: '600'
                                },

                                bodyFont: {

                                    size: 12
                                },

                                displayColors: true,

                                boxPadding: 6
                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                grid: {

                                    color: '#f1f5f9',

                                    drawBorder: false
                                },

                                ticks: {

                                    color: '#94a3b8',

                                    font: {

                                        size: 11
                                    },

                                    padding: 8
                                }

                            },

                            x: {

                                grid: {

                                    display: false
                                },

                                ticks: {

                                    color: '#94a3b8',

                                    font: {

                                        size: 11
                                    },

                                    padding: 8
                                }

                            }

                        }

                    }

                });

            }


            /* ===================================================== */
            /* DAILY SALES CHART                                    */
            /* ===================================================== */

            const dailySalesCanvas =
                document.getElementById('dailySalesChart');

            if (dailySalesCanvas) {

                const dailyCtx =
                    dailySalesCanvas.getContext('2d');


                new Chart(dailyCtx, {

                    type: 'bar',

                    data: {

                        labels: [
                            'Gross Sales',
                            'Paid Amount',
                            'Balance'
                        ],

                        datasets: [

                            {
                                label: 'Amount',

                                data: [
                                    @Model.DailySales.GrossSales,
                                    @Model.DailySales.PaidAmount,
                                    @Model.DailySales.BalanceAmount
                                ],

                                backgroundColor: [
                                    'rgba(15, 118, 110, 0.75)',
                                    'rgba(16, 185, 129, 0.75)',
                                    'rgba(245, 158, 11, 0.75)'
                                ],

                                borderColor: [
                                    '#0f766e',
                                    '#10b981',
                                    '#f59e0b'
                                ],

                                borderWidth: 1,

                                borderRadius: 6
                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function (context) {

                                        return ' Rs. ' +
                                            Number(context.raw)
                                                .toLocaleString();

                                    }

                                }

                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                grid: {

                                    color: '#f1f5f9'
                                },

                                ticks: {

                                    color: '#94a3b8',

                                    font: {
                                        size: 10
                                    },

                                    callback: function (value) {

                                        return 'Rs. ' +
                                            Number(value)
                                                .toLocaleString();

                                    }

                                }

                            },

                            x: {

                                grid: {
                                    display: false
                                },

                                ticks: {

                                    color: '#64748b',

                                    font: {

                                        size: 10,

                                        weight: '600'
                                    }

                                }

                            }

                        }

                    }

                });

            }


            /* ===================================================== */
            /* STOCK DISTRIBUTION CHART                              */
            /* ===================================================== */

            const stockCanvas =
                document.getElementById(
                    'stockDistributionChart');

            if (stockCanvas) {

                const stockCtx =
                    stockCanvas.getContext('2d');


                new Chart(stockCtx, {

                    type: 'doughnut',

                    data: {

                        labels: [
                            'Warehouse',
                            'Pharmacy'
                        ],

                        datasets: [

                            {

                                data: [
                                    @warehouseQuantity,
                                    @pharmacyQuantity
                                ],

                                backgroundColor: [
                                    '#0f766e',
                                    '#0ea5e9'
                                ],

                                borderColor: '#ffffff',

                                borderWidth: 3,

                                hoverOffset: 5
                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        cutout: '68%',

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function (context) {

                                        const value =
                                            Number(context.raw);

                                        const total =
                                            @totalStockQuantity;

                                        const percentage =
                                            total > 0
                                                ? ((value / total) * 100)
                                                    .toFixed(1)
                                                : 0;

                                        return ' ' +
                                            context.label +
                                            ': ' +
                                            value.toLocaleString() +
                                            ' (' +
                                            percentage +
                                            '%)';

                                    }

                                }

                            }

                        }

                    }

                });

            }


            /* ===================================================== */
            /* MONTHLY SALES CHART                                  */
            /* ===================================================== */

            const monthlyCanvas =
                document.getElementById(
                    'monthlySalesChart');

            if (monthlyCanvas) {

                const monthlyCtx =
                    monthlyCanvas.getContext('2d');


                const monthlyLabels =
                    @Html.Raw(
                        JsonSerializer.Serialize(monthlyLabels)
                    );


                const monthlySales =
                    @Html.Raw(
                        JsonSerializer.Serialize(monthlyGrossSales)
                    );


                new Chart(monthlyCtx, {

                    type: 'line',

                    data: {

                        labels: monthlyLabels,

                        datasets: [

                            {

                                label: 'Gross Sales',

                                data: monthlySales,

                                borderColor: '#7c3aed',

                                backgroundColor:
                                    'rgba(124, 58, 237, 0.10)',

                                borderWidth: 2.5,

                                tension: 0.35,

                                fill: true,

                                pointBackgroundColor: '#ffffff',

                                pointBorderColor: '#7c3aed',

                                pointBorderWidth: 2,

                                pointRadius: 3,

                                pointHoverRadius: 5
                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        interaction: {

                            intersect: false,

                            mode: 'index'
                        },

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function (context) {

                                        return ' Gross Sales: Rs. ' +
                                            Number(context.raw)
                                                .toLocaleString();

                                    }

                                }

                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                grid: {

                                    color: '#f1f5f9'
                                },

                                ticks: {

                                    color: '#94a3b8',

                                    font: {
                                        size: 10
                                    },

                                    callback: function (value) {

                                        return 'Rs. ' +
                                            Number(value)
                                                .toLocaleString();

                                    }

                                }

                            },

                            x: {

                                grid: {

                                    display: false
                                },

                                ticks: {

                                    color: '#94a3b8',

                                    font: {
                                        size: 10
                                    }

                                }

                            }

                        }

                    }

                });

            }

        });

    </script>
}




