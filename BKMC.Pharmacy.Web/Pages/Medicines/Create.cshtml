@page
@model BKMC.Pharmacy.Web.Pages.Medicines.CreateModel

@{
    ViewData["Title"] = "Create Medicine";
}
<style>
/* Medicine Information Card Header - Matching Table Header */
.card-header,
.card-header-custom {
    background-color:  #f8fafc; !important;    /* Light teal (table header jaisa) */
    background-image: none !important;       /* Gradient khatam */
    color: #0f766e !important;               /* Teal text */
    border-bottom: 1px solid #e2e8f0 !important;
    padding: 1rem 1.5rem !important;
    border-radius: 0 !important;
}

/* Header ke andar wale heading ka color aur weight */
.card-header h5,
.card-header-custom h5,
.card-header h4,
.card-header h6 {
    color: #0f766e !important;
    font-weight: 700 !important;
    letter-spacing: 0.5px;
    margin-bottom: 0 !important;
    text-transform: uppercase;              /* Table header jaisa uppercase */
    font-size: 0.85rem !important;
}
</style>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Create Medicine
            </h2>

            <p class="text-muted mb-0">
                Add a new medicine to the pharmacy master.
            </p>
        </div>

      
        <a asp-page="/Medicines/Index" 
   class="btn text-white fw-semibold" 
   style="background-color: #0f766e; border-color: #0f766e;">
    <i class="bi bi-arrow-left me-1"></i> Back to Medicines
</a>

    </div>


    <!-- Error -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @Model.ErrorMessage

        </div>
    }


    <!-- Form Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header">

            <h5 class="mb-0 fw-semibold">
                Medicine Information
            </h5>

        </div>


        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">

                    <!-- Medicine Code -->
                    <div class="col-md-6">

                        <label asp-for="Medicine.MedicineCode"
                               class="form-label fw-semibold">
                            Medicine Code
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Medicine.MedicineCode"
                               class="form-control"
                               placeholder="e.g. MED-001" />

                        <span asp-validation-for="Medicine.MedicineCode"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Medicine Name -->
                    <div class="col-md-6">

                        <label asp-for="Medicine.Name"
                               class="form-label fw-semibold">
                            Medicine Name
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Medicine.Name"
                               class="form-control"
                               placeholder="e.g. Panadol" />

                        <span asp-validation-for="Medicine.Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Generic Name -->
                    <div class="col-md-6">

                        <label asp-for="Medicine.GenericName"
                               class="form-label fw-semibold">
                            Generic Name
                        </label>

                        <input asp-for="Medicine.GenericName"
                               class="form-control"
                               placeholder="e.g. Paracetamol" />

                        <span asp-validation-for="Medicine.GenericName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Strength -->
                    <div class="col-md-3">

                        <label asp-for="Medicine.Strength"
                               class="form-label fw-semibold">
                            Strength
                        </label>

                        <input asp-for="Medicine.Strength"
                               class="form-control"
                               placeholder="e.g. 500mg" />

                        <span asp-validation-for="Medicine.Strength"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Form -->
                    <div class="col-md-3">

                        <label asp-for="Medicine.Form"
                               class="form-label fw-semibold">
                            Form
                        </label>

                        <input asp-for="Medicine.Form"
                               class="form-control"
                               placeholder="e.g. Tablet" />

                        <span asp-validation-for="Medicine.Form"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                    <a asp-page="/Medicines/Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Medicine

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}