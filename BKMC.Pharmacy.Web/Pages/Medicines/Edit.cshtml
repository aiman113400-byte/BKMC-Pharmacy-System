@page
@model BKMC.Pharmacy.Web.Pages.Medicines.EditModel

@{
    ViewData["Title"] = "Edit Medicine";
}

<!-- Embedded CSS for Professional Design -->
<style>
    .edit-page {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: #f8fafc; /* Page Background */
        padding: 2rem;
        color: #1e293b;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 900px;
        margin: 0 auto 1.5rem auto;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 0.25rem 0;
        }

        .page-header p {
            font-size: 0.875rem;
            color: #64748b;
            margin: 0;
        }

    /* Back Button - Teal matching Update Button */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #0f766e;
        color: #ffffff;
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: background-color 0.2s;
        border: none;
        cursor: pointer;
    }

        .btn-back:hover {
            background-color: #115e59;
        }

    /* Main Card */
    .card {
        background-color: #ffffff;
        max-width: 900px;
        margin: 0 auto;
        border-radius: 0.75rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    /* Card Header - Matching Page Header Background */
    .card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background-color: #f8fafc;
    }

        .card-header h2 {
            font-size: 1.125rem;
            font-weight: 600;
            color: #0f766e; /* Teal Text */
            margin: 0;
        }

    .badge-id {
        background-color: #e2e8f0;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
    }

    /* Form Body */
    .card-body {
        padding: 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #334155;
        margin-bottom: 0.375rem;
    }

    .required {
        color: #ef4444;
    }

    .form-input {
        width: 100%;
        padding: 0.625rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        color: #1e293b;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .form-input:focus {
            outline: none;
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
        }

    .validation-error {
        color: #ef4444;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Alert Box */
    .alert-error {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
        font-size: 0.875rem;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }

    /* Card Footer */
    .card-footer {
        padding: 1rem 1.5rem;
        background-color: #f8fafc;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    /* Buttons */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-cancel {
        background-color: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

        .btn-cancel:hover {
            background-color: #f1f5f9;
        }

    .btn-update {
        background-color: #0f766e; /* Teal */
        color: #ffffff;
        border: 1px solid #0f766e;
    }

        .btn-update:hover {
            background-color: #115e59;
        }

    /* Responsive - YAHAN FIX KIYA GAYA HAI (@@media) */
    @@media (max-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-back {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="edit-page">
    <!-- Top Header Section -->
    <div class="page-header">
        <div>
            <h1>Edit Medicine</h1>
            <p>Update medicine master information.</p>
        </div>

        <!-- Back Button (Teal Background) -->
        <a asp-page="./Index" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Back to Medicines
        </a>
    </div>

    <!-- Main Card -->
    <div class="card">

        <!-- Card Header (Light Background) -->
        <div class="card-header">
            <h2>Medicine Information</h2>
            <span class="badge-id">ID: @Model.Id</span>
        </div>

        <!-- Form -->
        <form method="post">
            <!-- Hidden field to ensure Id is passed on POST -->
            <input type="hidden" asp-for="Id" />

            <div class="card-body">

                <!-- Error Message Display -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert-error">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="flex-shrink:0;">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <span>@Model.ErrorMessage</span>
                    </div>
                }

                <div class="form-grid">

                    <!-- Medicine Name -->
                    <div class="form-group">
                        <label asp-for="Medicine.Name" class="form-label">
                            Medicine Name <span class="required">*</span>
                        </label>
                        <input asp-for="Medicine.Name" class="form-input" placeholder="Enter medicine name" />
                        <span asp-validation-for="Medicine.Name" class="validation-error"></span>
                    </div>

                    <!-- Generic Name -->
                    <div class="form-group">
                        <label asp-for="Medicine.GenericName" class="form-label">Generic Name</label>
                        <input asp-for="Medicine.GenericName" class="form-input" placeholder="Enter generic name" />
                        <span asp-validation-for="Medicine.GenericName" class="validation-error"></span>
                    </div>

                    <!-- Strength -->
                    <div class="form-group">
                        <label asp-for="Medicine.Strength" class="form-label">Strength</label>
                        <input asp-for="Medicine.Strength" class="form-input" placeholder="e.g., 500mg" />
                        <span asp-validation-for="Medicine.Strength" class="validation-error"></span>
                    </div>

                    <!-- Form -->
                    <div class="form-group">
                        <label asp-for="Medicine.Form" class="form-label">Form</label>
                        <input asp-for="Medicine.Form" class="form-input" placeholder="e.g., Tablet, Syrup" />
                        <span asp-validation-for="Medicine.Form" class="validation-error"></span>
                    </div>

                </div>
            </div>

            <!-- Footer / Actions -->
            <div class="card-footer">
                <a asp-page="./Index" class="btn btn-cancel">
                    Cancel
                </a>

                <button type="submit" class="btn btn-update">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    Update Medicine
                </button>
            </div>
        </form>
    </div>
</div>
<link rel="stylesheet" href="~/css/edit-medicine.css" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

