@page
@model BKMC.Pharmacy.Web.Pages.Medicines.IndexModel

@{
    ViewData["Title"] = "Medicines Master";

    var totalCount = Model.Medicines.Count;
    var activeCount = Model.Medicines.Count(m => m.IsActive);
    var inactiveCount = totalCount - activeCount;
}

<style>
    :root {
        --teal-primary: #0f766e;
        --teal-hover: #0d5c56;
        --border-color: #e2e8f0;
        --text-muted: #64748b;
        --text-dark: #1e293b;
    }

    body { background-color: #f8fafc; }

    /* FILTER BAR */
    .filter-bar {
        display: flex; flex-wrap: wrap; align-items: center;
        justify-content: space-between; background-color: #ffffff;
        border: 1px solid var(--border-color); border-radius: 0.5rem;
        padding: 0.5rem 1rem; margin-bottom: 1.25rem; gap: 0.75rem;
    }
    .filter-tabs { display: flex; align-items: center; gap: 0.25rem; }
    .filter-tab {
        text-decoration: none; color: var(--text-muted); font-weight: 500;
        font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 1.5rem;
        transition: all 0.2s ease; display: flex; align-items: center;
        gap: 0.3rem; border-bottom: none !important;
    }
    .filter-tab:hover { background-color: #f1f5f9; color: var(--teal-primary); }
    .filter-tab.active {
        background-color: transparent !important;
        color: var(--teal-primary) !important;
        font-weight: 700 !important; border-bottom: none !important;
    }
    .filter-tab__count {
        background-color: #f1f5f9; color: #475569; border-radius: 50%;
        padding: 0.1rem 0.35rem; font-size: 0.65rem; font-weight: 700;
    }
    .filter-tab.active .filter-tab__count {
        background-color: #ccfbf1; color: var(--teal-primary);
    }

    /* Search Input */
    .filter-search {
        position: relative; width: 100%; max-width: 320px;
        border: none !important; background: transparent !important;
        padding: 0 !important; box-shadow: none !important;
    }
    .filter-search i {
        position: absolute; left: 0.85rem; top: 50%;
        transform: translateY(-50%); color: #94a3b8; font-size: 0.9rem;
        pointer-events: none; z-index: 10;
    }
    .filter-search input {
        width: 100%; height: 36px; padding-left: 2.25rem !important;
        padding-right: 0.75rem; border: 1px solid var(--border-color) !important;
        border-radius: 0.375rem !important; background-color: #ffffff !important;
        font-size: 0.8rem; color: var(--text-dark);
        box-shadow: none !important; outline: none !important;
        transition: border-color 0.2s;
    }
    .filter-search input:focus {
        border-color: var(--teal-primary) !important;
        box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.1) !important;
    }

    /* TABLE DESIGN */
    .med-table-wrapper {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .med-table {
        table-layout: fixed; width: 100%; margin-bottom: 0;
        border-collapse: collapse;
    }

    /* HEADER - GREY (#f8fafc) - Returns page jaisa */
    .med-table th {
        background-color: #f8fafc; !important;
        background-image: none !important;
        --bs-table-bg: #f8fafc !important;
        color: #64748b !important;
        font-size: 0.75rem; text-transform: uppercase;
        letter-spacing: 0.05em; font-weight: 700;
        border-bottom: 1px solid #e2e8f0 !important;
        padding: 1rem 1.25rem !important;
        white-space: nowrap; vertical-align: middle;
    }

    .med-table tbody tr {
        border-bottom: 1px solid #f1f5f9 !important;
        transition: background-color 0.2s;
    }

    .med-table td {
        padding: 1rem 1.25rem !important; vertical-align: middle;
        font-size: 0.85rem; color: #334155;
        background: transparent !important;
        --bs-table-accent-bg: transparent !important;
        border: none !important;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

  
    /* 👇 HOVER - Complete Fix (Bootstrap ka box-shadow + variables sab override) 👇 */
.med-table tbody tr:hover,
.med-table tbody tr:hover td {
    background-color: D6F4ED!important;
    transition: background-color .15s ease;
    box-shadow: none !important; 
    --bs-table-accent-bg: #f8fafc !important;
    --bs-table-hover-bg: #f8fafc !important;
}
/* Medicines table - row hover (Returns page jaisa) */
/* Medicines table - row hover (teal) */
/* .table tbody tr:hover,
.table tbody tr:hover > td {
    
    
} */
    /* Status Pills */
    .status-pill {
        font-size: 0.65rem; font-weight: 600; padding: 0.2rem 0.5rem;
        border-radius: 2rem; display: inline-flex; align-items: center; gap: 0.25rem;
    }
    .status-pill--active { background-color: #dcfce7; color: #166534; }
    .status-pill--inactive { background-color: #fee2e2; color: #991b1b; }
    .status-pill .dot { width: 5px; height: 5px; border-radius: 50%; display: inline-block; }
    .status-pill--active .dot { background-color: #22c55e; }
    .status-pill--inactive .dot { background-color: #ef4444; }

    /* Action Buttons */
    .table-actions { display: flex; justify-content: flex-end; gap: 0.4rem; }
    .icon-btn {
        border: 1px solid var(--border-color); color: var(--text-muted);
        background: #ffffff; border-radius: 0.375rem;
        width: 28px; height: 28px;
        display: inline-flex; align-items: center; justify-content: center;
        transition: all 0.2s; text-decoration: none; font-size: 0.8rem;
    }
    .icon-btn:hover {
        background-color: #f8fafc; color: var(--teal-primary);
        border-color: var(--teal-primary);
    }
    .icon-btn.danger:hover {
        color: #dc2626; border-color: #fca5a5; background-color: #fef2f2;
    }

    /* Page Header */
    .btn-add {
        background-color: var(--teal-primary); color: #ffffff; border: none;
        font-weight: 500; padding: 0.5rem 1rem; border-radius: 0.375rem;
        text-decoration: none; display: inline-flex; align-items: center;
        gap: 0.4rem; transition: all 0.2s ease; font-size: 0.85rem;
    }
    .btn-add:hover { background-color: var(--teal-hover); color: #ffffff; }
    .page-header__breadcrumb { font-size: 0.65rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.1em; margin-bottom: 0.2rem; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.2rem; letter-spacing: -0.5px; }
    .page-header__subtitle { font-size: 0.8rem; color: var(--text-muted); margin: 0; }
</style>

<div class="container-fluid py-4">

    <div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-3">
        <div>
            <div class="page-header__breadcrumb">Master Data · <span>Medicines</span></div>
            <h1 class="page-header__title">Medicines Master</h1>
            <p class="page-header__subtitle">All medicine definitions from the database</p>
        </div>
        <a asp-page="/Medicines/Create" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Medicine
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0 shadow-sm" style="border-radius: 0.5rem; font-size: 0.85rem;">
            <i class="bi bi-exclamation-triangle me-2"></i> @Model.ErrorMessage
        </div>
    }

    <form method="get">
        <div class="filter-bar">
            <div class="filter-tabs">
                <a asp-page="/Medicines/Index" class="filter-tab @(Model.IsActive == null ? "active" : "")">
                    All <span class="filter-tab__count">@totalCount</span>
                </a>
                <a asp-page="/Medicines/Index" asp-route-IsActive="true" class="filter-tab @(Model.IsActive == true ? "active" : "")">
                    Active <span class="filter-tab__count">@activeCount</span>
                </a>
                <a asp-page="/Medicines/Index" asp-route-IsActive="false" class="filter-tab @(Model.IsActive == false ? "active" : "")">
                    Inactive <span class="filter-tab__count">@inactiveCount</span>
                </a>
            </div>
            <div class="filter-search">
                <i class="bi bi-search"></i>
                <input type="text" name="Search" value="@Model.Search" placeholder="Search by generic, brand or code" />
            </div>
        </div>
    </form>

    <div class="med-table-wrapper">
        @if (Model.Medicines.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-capsule" style="font-size: 2.5rem; color: #d1d5db;"></i>
                <h5 class="mt-3" style="color: #6b7280; font-size: 0.9rem;">No medicines found</h5>
                <p style="color: #9ca3af; font-size: 0.78rem; margin: 0;">Try changing your search or filter.</p>
            </div>
        }
        else
        {
           <table class="table table-hover align-middle mb-0" style="--bs-table-hover-bg: D6F4ED">
                <thead>
                    <tr>
                       <th class="text-uppercase small fw-bold text-secondary py-3 px-4 border-0" style="width: 25%;">Medicine</th>
                        <th class="text-start" style="width: 25%;">Generic Name</th>
                        <th class="text-start" style="width: 12%;">Strength</th>
                        <th class="text-start" style="width: 10%;">Unit</th>
                        <th class="text-center" style="width: 15%;">Status</th>
                        <th class="text-end" style="width: 13%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var medicine in Model.Medicines)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark text-truncate">@medicine.Name</div>
                                <div class="text-muted small">@medicine.Strength</div>
                            </td>
                            <td class="text-muted text-truncate">
                                @(string.IsNullOrWhiteSpace(medicine.GenericName) ? "-" : medicine.GenericName)
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(medicine.Strength) ? "-" : medicine.Strength)
                            </td>
                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(medicine.Form) ? "-" : medicine.Form)
                            </td>
                            <td class="text-center">
                                @if (medicine.IsActive)
                                {
                                    <span class="status-pill status-pill--active"><span class="dot"></span> Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-pill--inactive"><span class="dot"></span> Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Medicines/Edit" asp-route-id="@medicine.Id" class="icon-btn" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (medicine.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@medicine.Id" style="display:inline;">
                                            <button type="submit" class="icon-btn danger" title="Deactivate" onclick="return confirm('Deactivate this medicine?');">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@medicine.Id" style="display:inline;">
                                            <button type="submit" class="icon-btn" title="Activate">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =========================================================
        // JAVASCRIPT FALLBACK - Forcefully apply
        // =========================================================

        // 1. Header ko forcefully GREY (#f8fafc) karein
        document.querySelectorAll('.med-table th').forEach(th => {
            th.style.setProperty('background-color', '#f8fafc', 'important');
            th.style.setProperty('background-image', 'none', 'important');
            th.style.setProperty('color', '#64748b', 'important');
        });

        // 2. Row Hover par forcefully GREY (#f8fafc) karein - Returns Page jaisa
        document.querySelectorAll('.med-table tbody tr').forEach(tr => {
            tr.addEventListener('mouseenter', function () {
                this.style.setProperty('background-color', '#f8fafc', 'important');
                this.querySelectorAll('td').forEach(td => {
                    td.style.setProperty('background-color', '#f8fafc', 'important');
                });
            });
            tr.addEventListener('mouseleave', function () {
                this.style.setProperty('background-color', 'transparent', 'important');
                this.querySelectorAll('td').forEach(td => {
                    td.style.setProperty('background-color', 'transparent', 'important');
                });
            });
        });

        // =========================================================
        // Search aur Filter ka purana JavaScript
        // =========================================================
        const searchInput = document.querySelector('input[placeholder*="Search by generic"]');
        const tableBody = document.querySelector('table tbody');
        const filterTabs = document.querySelectorAll('.filter-tab, .nav-pills .nav-link, button[data-filter]');

        if (!searchInput || !tableBody) return;

        function filterTable() {
            const query = searchInput.value.toLowerCase().trim();
            const rows = tableBody.querySelectorAll('tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const rowText = row.textContent.toLowerCase();
                if (rowText.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            let noResultRow = document.getElementById('noResultRow');
            if (visibleCount === 0) {
                if (!noResultRow) {
                    noResultRow = document.createElement('tr');
                    noResultRow.id = 'noResultRow';
                    noResultRow.innerHTML = `<td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-search me-2"></i> No medicines found matching "<strong>${query}</strong>"
                    </td>`;
                    tableBody.appendChild(noResultRow);
                } else {
                    noResultRow.style.display = '';
                    noResultRow.querySelector('td').innerHTML =
                        `<i class="bi bi-search me-2"></i> No medicines found matching "<strong>${query}</strong>"`;
                }
            } else if (noResultRow) {
                noResultRow.style.display = 'none';
            }
        }

        searchInput.addEventListener('input', filterTable);
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { searchInput.value = ''; filterTable(); }
        });

        filterTabs.forEach(tab => {
            tab.addEventListener('click', function () {
                searchInput.value = '';
                tableBody.querySelectorAll('tr').forEach(row => row.style.display = '');
                const noResultRow = document.getElementById('noResultRow');
                if (noResultRow) noResultRow.style.display = 'none';
            });
        });
    });
</script>

