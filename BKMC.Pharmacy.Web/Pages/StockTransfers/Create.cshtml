
@page
@model BKMC.Pharmacy.Web.Pages.StockTransfers.CreateModel
@using BKMC.Pharmacy.Web.Models.Stock

@{
    ViewData["Title"] = "Create Stock Transfer";
}

<div class="container-fluid py-4">

    <!-- =========================
         PAGE HEADER
    ========================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>
                Create Stock Transfer
            </h2>

            <p class="text-muted mb-0">
                Transfer stock from one location to another.
            </p>
        </div>

        <a asp-page="/StockTransfers/Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Transfers

        </a>

    </div>


    <!-- =========================
         ERROR MESSAGE
    ========================== -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @Model.ErrorMessage

        </div>
    }


    <!-- =========================
         MAIN FORM
    ========================== -->
    <form method="post">

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <!-- =========================
             TRANSFER INFORMATION
        ========================== -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">
                    Transfer Information
                </h5>

            </div>


            <div class="card-body">

                <div class="row g-3">

                    <!-- From Location -->
                    <div class="col-md-6">

                        <label asp-for="Transfer.FromLocation"
                               class="form-label fw-semibold">

                            From Location

                        </label>


                        <select asp-for="Transfer.FromLocation"
                                class="form-select">

                            <option value="@StockLocation.Warehouse">
                                Warehouse
                            </option>

                            <option value="@StockLocation.Pharmacy">
                                Pharmacy
                            </option>

                        </select>

                    </div>


                    <!-- To Location -->
                    <div class="col-md-6">

                        <label asp-for="Transfer.ToLocation"
                               class="form-label fw-semibold">

                            To Location

                        </label>


                        <select asp-for="Transfer.ToLocation"
                                class="form-select">

                            <option value="@StockLocation.Pharmacy">
                                Pharmacy
                            </option>

                            <option value="@StockLocation.Warehouse">
                                Warehouse
                            </option>

                        </select>

                    </div>


                    <!-- Transfer Date -->
                    <div class="col-md-6">

                        <label asp-for="Transfer.TransferDate"
                               class="form-label fw-semibold">

                            Transfer Date

                        </label>


                        <input asp-for="Transfer.TransferDate"
                               type="date"
                               class="form-control" />

                    </div>


                    <!-- Reference Number -->
                    <div class="col-md-6">

                        <label asp-for="Transfer.ReferenceNumber"
                               class="form-label fw-semibold">

                            Reference Number

                        </label>


                        <input asp-for="Transfer.ReferenceNumber"
                               class="form-control"
                               placeholder="e.g. TR-2026-001" />

                    </div>


                    <!-- Remarks -->
                    <div class="col-12">

                        <label asp-for="Transfer.Remarks"
                               class="form-label fw-semibold">

                            Remarks

                        </label>


                        <textarea asp-for="Transfer.Remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Optional remarks...">
                        </textarea>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             TRANSFER ITEMS
        ========================== -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-box-seam me-2"></i>

                    Transfer Items

                </h5>

            </div>


            <div class="card-body">

                @for (int i = 0;
                     i < Model.Transfer.Items.Count;
                     i++)
                {
                    <div class="row g-3 mb-4">


                        <!-- =====================
                             MEDICINE
                        ====================== -->
                        <div class="col-md-5">

                            <label class="form-label fw-semibold">

                                Medicine

                            </label>


                            <select asp-for="Transfer.Items[i].MedicineId"
                                    class="form-select medicine-select"
                                    data-item-index="@i">

                                <option value="0">
                                    Select Medicine
                                </option>


                                @foreach (var medicine in Model.Medicines)
                                {
                                    <option value="@medicine.Id">

                                        @medicine.Name

                                    </option>
                                }

                            </select>

                        </div>


                        <!-- =====================
                             BATCH
                        ====================== -->
                        <div class="col-md-4">

                            <label class="form-label fw-semibold">

                                Batch

                            </label>


                            <select asp-for="Transfer.Items[i].BatchId"
                                    class="form-select batch-select"
                                    data-item-index="@i">

                                <option value="0">
                                    Select Batch
                                </option>


                                @foreach (var stock in Model.Stocks)
                                {
                                    <option value="@stock.BatchId"
                                            data-medicine-id="@stock.MedicineId"
                                            data-available-quantity="@stock.Quantity">

                                        @stock.BatchNumber
                                        - Available: @stock.Quantity

                                    </option>
                                }

                            </select>

                        </div>


                        <!-- =====================
                             QUANTITY
                        ====================== -->
                        <div class="col-md-3">

                            <label class="form-label fw-semibold">

                                Quantity

                            </label>


                            <input asp-for="Transfer.Items[i].Quantity"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control quantity-input"
                                   data-item-index="@i"
                                   placeholder="Enter quantity" />


                            <small class="text-muted available-quantity"
                                   data-item-index="@i">

                                Available: -

                            </small>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- =========================
             ACTION BUTTONS
        ========================== -->
        <div class="d-flex justify-content-end gap-2">

            <a asp-page="/StockTransfers/Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>

                Cancel

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>

                Create Transfer

            </button>

        </div>

    </form>

</div>


