}

html[data-theme="dark"] .reports-page .report-table tbody tr:hover {
    background: #1E293B !important;
}

html[data-theme="dark"] .reports-page .report-table td {
    background: transparent !important;
    color: #E2E8F0 !important;
    border-color: #263244 !important;
    vertical-align: middle !important;
}

html[data-theme="dark"] .reports-page .report-table tbody tr:hover td {
    background: #1E293B !important;
    color: #FFFFFF !important;
}

/* =========================================================
   TABLE TEXT
   ========================================================= */

html[data-theme="dark"] .reports-page .medicine-name {
    color: #FFFFFF !important;
    font-weight: 600 !important;
}

html[data-theme="dark"] .reports-page .medicine-code {
    color: #94A3B8 !important;
}

html[data-theme="dark"] .reports-page .sales-time {
    color: #CBD5E1 !important;
}

html[data-theme="dark"] .reports-page .sales-amount {
    color: #FFFFFF !important;
