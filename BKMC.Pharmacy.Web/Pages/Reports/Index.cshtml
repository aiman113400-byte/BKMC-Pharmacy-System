</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("stockSearch");

        const locationFilter =
            document.getElementById("locationFilter");

        const clearButton =
            document.getElementById("clearStockFilters");

        const table =
            document.getElementById("stockSummaryTable");

        const tableBody =
            document.getElementById("stockSummaryBody");

        const filterEmptyState =
            document.getElementById("filterEmptyState");

        const visibleStockCount =
            document.getElementById("visibleStockCount");

        const stockRecordCount =
            document.getElementById("stockRecordCount");

        const printReportBtn =
            document.getElementById("printReportBtn");

        const exportStockCsvBtn =
            document.getElementById("exportStockCsvBtn");


        // FIX: Clear button ki zaroorat nahi hai. Sirf zaroori elements check karein.
        if (!searchInput ||
            !locationFilter ||
            !table ||
            !tableBody) {

            console.error("Required DOM elements for stock filtering are missing.");
            return;
        }


        const stockRows =
            Array.from(
                tableBody.querySelectorAll(".stock-row")
            );


        const totalStockCount =
            stockRows.length;


        function updateRowNumbers(visibleRows) {

            visibleRows.forEach(function (row, index) {

                const numberCell =
                    row.querySelector(".stock-row-number");

                if (numberCell) {

                    numberCell.textContent =
                        index + 1;

                }

            });

        }


        function updateRecordBadge(count) {

            if (!stockRecordCount) {
                return;
            }

            stockRecordCount.textContent =
                count +
                (count === 1
                    ? " Record"
                    : " Records");

        }


        function updateExportButton(count) {

            if (!exportStockCsvBtn) {
                return;
            }

            exportStockCsvBtn.disabled =
                count === 0;

        }


        function filterStockRows() {

            const searchValue =
                searchInput.value
                    .trim()
                    .toLowerCase();

            const selectedLocation =
                locationFilter.value;

            const visibleRows = [];


            stockRows.forEach(function (row) {

                const medicine =
                    row.dataset.medicine || "";

                const batch =
                    row.dataset.batch || "";

                const location =
                    row.dataset.location || "";


                const matchesSearch =
                    searchValue === "" ||
                    medicine.includes(searchValue) ||
                    batch.includes(searchValue);


                const matchesLocation =
                    selectedLocation === "all" ||
                    location === selectedLocation;


                const shouldShow =
                    matchesSearch &&
                    matchesLocation;


                row.style.display =
                    shouldShow ? "" : "none";


                if (shouldShow) {
                    visibleRows.push(row);
                }

            });


            updateRowNumbers(visibleRows);


            if (visibleStockCount) {

                visibleStockCount.textContent =
                    visibleRows.length;

            }


            updateRecordBadge(
                visibleRows.length
            );


            updateExportButton(
                visibleRows.length
            );


            if (filterEmptyState) {

                filterEmptyState.style.display =
                    visibleRows.length === 0
                        ? "block"
                        : "none";

            }


            table.style.display =
                visibleRows.length === 0
                    ? "none"
                    : "";


            if (totalStockCount === 0) {

                table.style.display =
                    "none";

            }

        }


        function clearFilters() {

            searchInput.value = "";

            locationFilter.value = "all";

            filterStockRows();

            searchInput.focus();

        }


        function getVisibleRows() {

            return stockRows.filter(function (row) {

                return row.style.display !== "none";

            });

        }


        function escapeCsvValue(value) {

            const stringValue =
                String(value ?? "");

            return '"' +
                stringValue.replace(/"/g, '""') +
                '"';

        }


        function exportStockCsv() {

            const visibleRows =
                getVisibleRows();


            if (visibleRows.length === 0) {
                return;
            }


            const csvRows = [];


            csvRows.push(
                [
                    "Medicine",
                    "Batch",
                    "Location",
                    "Quantity",
                    "Last Updated"
                ]
                    .map(escapeCsvValue)
                    .join(",")
            );


            visibleRows.forEach(function (row) {

                const medicineElement =
                    row.querySelector(
                        ".medicine-name strong"
                    );

                const batchElement =
                    row.querySelector(
                        ".code-badge"
                    );

                const locationElement =
                    row.querySelector(
                        ".location-badge"
                    );

                const quantityCell =
                    row.cells[4];

                const updatedElement =
                    row.querySelector(
                        ".updated-date"
                    );


                const medicine =
                    medicineElement
                        ? medicineElement.textContent.trim()
                        : "";


                const batch =
                    batchElement
                        ? batchElement.textContent.trim()
                        : "";


                const location =
                    locationElement
                        ? locationElement.textContent.trim()
                        : "Unknown";


                const quantityText =
                    quantityCell
                        ? quantityCell.textContent.trim()
                        : "0";


                const quantity =
                    quantityText.replace(/,/g, "");


                const lastUpdated =
                    updatedElement
                        ? updatedElement.textContent.trim()
                        : "";


                csvRows.push(
                    [
                        medicine,
                        batch,
                        location,
                        quantity,
                        lastUpdated
                    ]
                        .map(escapeCsvValue)
                        .join(",")
                );

            });


            const csvContent =
                "\uFEFF" +
                csvRows.join("\r\n");


            const blob =
                new Blob(
                    [csvContent],
                    {
                        type: "text/csv;charset=utf-8;"
                    }
                );


            const url =
                URL.createObjectURL(blob);


            const link =
                document.createElement("a");


            const today =
                new Date();


            const year =
                today.getFullYear();


            const month =
                String(today.getMonth() + 1)
                    .padStart(2, "0");


            const day =
                String(today.getDate())
                    .padStart(2, "0");


            link.href = url;


            link.download =
                "BKMC-Stock-Report-" +
                year +
                "-" +
                month +
                "-" +
                day +
                ".csv";


            document.body.appendChild(link);

            link.click();

            document.body.removeChild(link);

            URL.revokeObjectURL(url);

        }


        function printReport() {

            window.print();

        }


        searchInput.addEventListener(
            "input",
            filterStockRows
        );


        locationFilter.addEventListener(
            "change",
            filterStockRows
        );

        // FIX: Clear button ka event listener conditional bana diya hai
        if (clearButton) {
            clearButton.addEventListener(
                "click",
                clearFilters
            );
        }


        if (exportStockCsvBtn) {

            exportStockCsvBtn.addEventListener(
                "click",
                exportStockCsv
            );

        }


        if (printReportBtn) {

            printReportBtn.addEventListener(
                "click",
                printReport
            );

        }


        filterStockRows();

    });

</script>




