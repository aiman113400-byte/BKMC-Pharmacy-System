@page
@model BKMC.Pharmacy.Web.Pages.Reports.IndexModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="reports-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-bar-chart-line"></i>
                Reports &amp; Analytics
            </h2>
            <p class="page-subtitle">
                Monitor inventory, stock distribution, low-stock medicines and daily sales.
            </p>
        </div>

        <div class="report-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </div>
    </div>


    <!-- API ERROR -->
    @if (!Model.ApiAvailable)
    {
        <div class="alert alert-danger api-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Reports unavailable</strong>
                <div>@Model.ApiMessage</div>
            </div>
        </div>
    }
    else
    {
        <!-- =========================================================
             DAILY SALES REPORT
             ========================================================= -->
        <div class="report-section daily-sales-section">

            <div class="section-header">
                <div class="section-title-group">
                    <div class="section-icon icon-teal">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>
                        <h4>Daily Sales Report</h4>
                        <p>
                            View billing and sales performance for a selected date.
                        </p>
                    </div>
                </div>

                <form method="get" class="daily-sales-date-form">
                    <label for="salesDate">
                        <i class="bi bi-calendar3"></i>
                        Sales Date
                    </label>

                    <div class="daily-sales-date-control">
                        <input type="date"
                               id="salesDate"
                               name="date"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               class="daily-sales-date-input" />

                        <button type="submit"
                                class="daily-sales-view-btn">
                            <i class="bi bi-search"></i>
                            View Report
                        </button>
                    </div>
                </form>
            </div>


            <!-- SELECTED DATE -->
            <div class="daily-sales-date-display">
                <div>
                    <span class="daily-sales-date-label">
                        Sales for
                    </span>

                    <strong>
                        @Model.SelectedDate.ToString("dddd, dd MMMM yyyy")
                    </strong>
                </div>

                <span class="daily-sales-date-badge">
                    <i class="bi bi-calendar-check"></i>
                    @Model.SelectedDate.ToString("dd MMM yyyy")
                </span>
            </div>


            <!-- DAILY SALES CARDS -->
            <div class="daily-sales-summary-grid">

                <!-- TOTAL BILLS -->
                <div class="sales-summary-card">
                    <div class="sales-summary-icon sales-icon-blue">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div class="sales-summary-content">
                        <span class="sales-summary-label">
                            Total Bills
                        </span>

                        <h3>
                            @Model.DailySales.TotalBills
                        </h3>

                        <small>
                            Bills generated
                        </small>
                    </div>
                </div>


                <!-- GROSS SALES -->
                <div class="sales-summary-card">
                    <div class="sales-summary-icon sales-icon-teal">
                        <i class="bi bi-currency-dollar"></i>
                    </div>

                    <div class="sales-summary-content">
                        <span class="sales-summary-label">
                            Gross Sales
                        </span>

                        <h3>
                            Rs. @Model.DailySales.GrossSales.ToString("N2")
                        </h3>

                        <small>
                            Total bill amount
                        </small>
                    </div>
                </div>


                <!-- PAID AMOUNT -->
                <div class="sales-summary-card">
                    <div class="sales-summary-icon sales-icon-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div class="sales-summary-content">
                        <span class="sales-summary-label">
                            Paid Amount
                        </span>

                        <h3>
                            Rs. @Model.DailySales.PaidAmount.ToString("N2")
                        </h3>

                        <small>
                            Amount received
                        </small>
                    </div>
                </div>


                <!-- BALANCE -->
                <div class="sales-summary-card">
                    <div class="sales-summary-icon sales-icon-amber">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div class="sales-summary-content">
                        <span class="sales-summary-label">
                            Balance
                        </span>

                        <h3>
                            Rs. @Model.DailySales.BalanceAmount.ToString("N2")
                        </h3>

                        <small>
                            Outstanding amount
                        </small>
                    </div>
                </div>


                <!-- MEDICINES SOLD -->
                <div class="sales-summary-card">
                    <div class="sales-summary-icon sales-icon-purple">
                        <i class="bi bi-capsule"></i>
                    </div>

                    <div class="sales-summary-content">
                        <span class="sales-summary-label">
                            Medicines Sold
                        </span>

                        <h3>
                            @Model.DailySales.MedicinesSold.ToString("N2")
                        </h3>

                        <small>
                            Total units sold
                        </small>
                    </div>
                </div>

            </div>


            <!-- DAILY SALES TABLE -->
            @if (Model.DailySales.Bills.Any())
            {
                <div class="daily-sales-table-header">
                    <div>
                        <h5>
                            <i class="bi bi-receipt-cutoff"></i>
                            Daily Bills
                        </h5>

                        <p>
                            All bills generated on
                            @Model.SelectedDate.ToString("dd MMMM yyyy")
                        </p>
                    </div>

                    <span class="daily-bills-count">
                        @Model.DailySales.TotalBills
                        @(Model.DailySales.TotalBills == 1 ? "Bill" : "Bills")
                    </span>
                </div>


                <div class="table-wrapper">
                    <table class="report-table daily-sales-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Bill Number</th>
                                <th>Patient</th>
                                <th>Time</th>
                                <th>Total Amount</th>
                                <th>Paid Amount</th>
                                <th>Balance</th>
                                <th>Medicines</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int dailyBillCounter = 1;
                            }

                            @foreach (var bill in Model.DailySales.Bills)
                            {
                                <tr>
                                    <td>
                                        @dailyBillCounter
                                    </td>

                                    <td>
                                        <span class="bill-number-badge">
                                            <i class="bi bi-receipt"></i>
                                            @bill.BillNumber
                                        </span>
                                    </td>

                                    <td>
                                        <div class="medicine-name">
                                            <strong>
                                                @bill.PatientName
                                            </strong>

                                            <span>
                                                Patient ID: @bill.PatientId
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="sales-time">
                                            @bill.BillDate.ToLocalTime().ToString("hh:mm tt")
                                        </span>
                                    </td>

                                    <td>
                                        <strong class="sales-amount">
                                            Rs. @bill.TotalAmount.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        <strong class="paid-amount">
                                            Rs. @bill.PaidAmount.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @if (bill.BalanceAmount > 0)
                                        {
                                            <strong class="balance-amount">
                                                Rs. @bill.BalanceAmount.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="paid-status-badge">
                                                <i class="bi bi-check-circle"></i>
                                                Paid
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="medicine-count-badge">
                                            @bill.MedicinesSold.ToString("N2")
                                        </span>
                                    </td>
                                </tr>

                                dailyBillCounter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- NO SALES -->
                <div class="empty-state daily-sales-empty-state">
                    <div class="empty-icon empty-icon-teal">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <h5>
                        No Sales Found
                    </h5>

                    <p>
                        No bills were generated on
                        @Model.SelectedDate.ToString("dd MMMM yyyy").
                    </p>
                </div>
            }
        </div>


        <!-- =========================================================
             MONTHLY SALES REPORT
             ========================================================= -->
        <div class="report-section monthly-sales-section">

            <div class="section-header monthly-sales-header">

                <div class="section-title-group">

                    <div class="section-icon icon-teal">
                        <i class="bi bi-calendar-month"></i>
                    </div>

                    <div>
                        <h4>
                            Monthly Sales Report
                        </h4>

                        <p>
                            View sales summary and daily sales breakdown for a selected month.
                        </p>
                    </div>

                </div>


                <form method="get"
                      class="monthly-sales-date-form">

                    <div class="monthly-sales-field">

                        <label for="salesYear">
                            Year
                        </label>

                        <select id="salesYear"
                                name="year"
                                class="monthly-sales-select">

                            @for (var year = DateTime.Today.Year - 5;
                                  year <= DateTime.Today.Year + 1;
                                  year++)
                            {
                                if (year == Model.SelectedYear)
                                {
                                    <option value="@year" selected>
                                        @year
                                    </option>
                                }
                                else
                                {
                                    <option value="@year">
                                        @year
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <div class="monthly-sales-field">

                        <label for="salesMonth">
                            Month
                        </label>

                        <select id="salesMonth"
                                name="month"
                                class="monthly-sales-select">

                                @for (var month = 1; month <= 12; month++)
                                   {
                                        var monthName = new DateTime(2024, month, 1).ToString("MMMM");
    
                                         if (month == Model.SelectedMonth)
                                                {
                                                     <option value="@month" selected>@monthName</option>
                                                       }
                                          else
                                                  {
                                                    <option value="@month">@monthName</option>
                                                         }
                                                           }

                        </select>

                    </div>


                    <button type="submit"
                            class="monthly-sales-view-btn">

                         <i class="bi bi-search"></i> 
                        View Report

                    </button>

                </form>

            </div>


            <!-- SELECTED MONTH -->
            <div class="monthly-sales-period">

                <i class="bi bi-calendar3"></i>

                 <span>
        @(new DateTime(Model.MonthlySales.Year, Model.MonthlySales.Month, 1).ToString("MMMM"))
        @Model.MonthlySales.Year
    </span>

                @* <span>
                    @Model.MonthlySales.MonthName
                    @Model.MonthlySales.Year
                </span> *@

            </div>


            <!-- MONTHLY SUMMARY CARDS -->
            <div class="monthly-sales-summary-grid">

                <!-- TOTAL BILLS -->
                <div class="monthly-sales-card">

                    <div class="monthly-sales-card-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <div>
                        <span>
                            Total Bills
                        </span>

                        <strong>
                            @Model.MonthlySales.TotalBills
                        </strong>
                    </div>

                </div>


                <!-- GROSS SALES -->
                <div class="monthly-sales-card">

                    <div class="monthly-sales-card-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <div>
                        <span>
                            Gross Sales
                        </span>

                        <strong>
                            Rs. @Model.MonthlySales.GrossSales.ToString("N2")
                        </strong>
                    </div>

                </div>


                <!-- PAID AMOUNT -->
                <div class="monthly-sales-card">

                    <div class="monthly-sales-card-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                    <div>
                        <span>
                            Paid Amount
                        </span>

                        <strong>
                            Rs. @Model.MonthlySales.PaidAmount.ToString("N2")
                        </strong>
                    </div>

                </div>


                <!-- BALANCE -->
                <div class="monthly-sales-card">

                    <div class="monthly-sales-card-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <span>
                            Balance
                        </span>

                        <strong>
                            Rs. @Model.MonthlySales.BalanceAmount.ToString("N2")
                        </strong>
                    </div>

                </div>


                <!-- MEDICINES SOLD -->
                <div class="monthly-sales-card">

                    <div class="monthly-sales-card-icon">
                        <i class="bi bi-capsule"></i>
                    </div>

                    <div>
                        <span>
                            Medicines Sold
                        </span>

                        <strong>
                            @Model.MonthlySales.MedicinesSold.ToString("N2")
                        </strong>
                    </div>

                </div>

            </div>


            <!-- DAILY BREAKDOWN -->
            <div class="monthly-sales-table-wrapper">

                <div class="table-title">

                    <h3>
                        <i class="bi bi-bar-chart"></i>
                        Daily Sales Breakdown
                    </h3>

                </div>


                @if (Model.MonthlySales.DailySales.Any())
                {
                    <div class="table-responsive">

                        <table class="report-table monthly-sales-table">

                            <thead>

                                <tr>
                                    <th>Date</th>
                                    <th>Bills</th>
                                    <th>Gross Sales</th>
                                    <th>Paid Amount</th>
                                    <th>Balance</th>
                                    <th>Medicines Sold</th>
                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var day in Model.MonthlySales.DailySales)
                                {
                                    <tr>

                                        <td>
                                            @day.Date.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @day.TotalBills
                                        </td>

                                        <td>
                                            Rs. @day.GrossSales.ToString("N2")
                                        </td>

                                        <td>
                                            Rs. @day.PaidAmount.ToString("N2")
                                        </td>

                                        <td>
                                            Rs. @day.BalanceAmount.ToString("N2")
                                        </td>

                                        <td>
                                            @day.MedicinesSold.ToString("N2")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="monthly-sales-empty">

                        <i class="bi bi-calendar-x"></i>

                        <h3>
                            No Sales Found
                        </h3>

                        <p>
                            There are no sales records for
                            @Model.MonthlySales.MonthName
                            @Model.MonthlySales.Year.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- =========================================================
             STOCK SUMMARY CARDS
             ========================================================= -->
        <div class="summary-grid">

            <div class="summary-card">
                <div class="summary-icon icon-teal">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div class="summary-content">
                    <span class="summary-label">
                        Stock Records
                    </span>

                    <h3>
                        @Model.StockSummary.TotalStockRecords
                    </h3>

                    <small>
                        Active inventory records
                    </small>
                </div>
            </div>


            <div class="summary-card">
                <div class="summary-icon icon-blue">
                    <i class="bi bi-building"></i>
                </div>

                <div class="summary-content">
                    <span class="summary-label">
                        Warehouse Stock
                    </span>

                    <h3>
                        @Model.StockSummary.TotalWarehouseQuantity.ToString("N2")
                    </h3>

                    <small>
                        Total warehouse quantity
                    </small>
                </div>
            </div>


            <div class="summary-card">
                <div class="summary-icon icon-purple">
                    <i class="bi bi-hospital"></i>
                </div>

                <div class="summary-content">
                    <span class="summary-label">
                        Pharmacy Stock
                    </span>

                    <h3>
                        @Model.StockSummary.TotalPharmacyQuantity.ToString("N2")
                    </h3>

                    <small>
                        Total pharmacy quantity
                    </small>
                </div>
            </div>


            <div class="summary-card">
                <div class="summary-icon icon-amber">
                    <i class="bi bi-boxes"></i>
                </div>

                <div class="summary-content">
                    <span class="summary-label">
                        Total Stock
                    </span>

                    <h3>
                        @Model.StockSummary.TotalQuantity.ToString("N2")
                    </h3>

                    <small>
                        Warehouse + Pharmacy
                    </small>
                </div>
            </div>

        </div>


        <!-- =========================================================
             LOW STOCK REPORT
             ========================================================= -->
        <div class="report-section">

            <div class="section-header">

                <div class="section-title-group">

                    <div class="section-icon icon-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <div>
                        <h4>
                            Low Stock Report
                        </h4>

                        <p>
                            Medicines whose total available quantity is below the reorder level.
                        </p>
                    </div>

                </div>

                <span class="low-stock-count">
                    <i class="bi bi-exclamation-circle me-1"></i>

                    @Model.LowStockItems.Count

                    @(Model.LowStockItems.Count == 1
                        ? "Medicine"
                        : "Medicines")
                </span>

            </div>


            @if (Model.LowStockItems.Any())
            {
                <div class="table-wrapper">

                    <table class="report-table">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Medicine</th>
                                <th>Code</th>
                                <th>Reorder Level</th>
                                <th>Warehouse</th>
                                <th>Pharmacy</th>
                                <th>Total Stock</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var item in Model.LowStockItems)
                            {
                                <tr>

                                    <td>
                                        @counter
                                    </td>

                                    <td>
                                        <div class="medicine-name">

                                            <strong>
                                                @item.MedicineName
                                            </strong>

                                            <span>
                                                ID: @item.MedicineId
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="code-badge">
                                            @item.MedicineCode
                                        </span>
                                    </td>

                                    <td>
                                        @item.ReorderLevel.ToString("N2")
                                    </td>

                                    <td>
                                        @item.WarehouseQuantity.ToString("N2")
                                    </td>

                                    <td>
                                        @item.PharmacyQuantity.ToString("N2")
                                    </td>

                                    <td>
                                        <strong class="qty-highlight">
                                            @item.TotalQuantity.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="status-badge">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Low Stock
                                        </span>
                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon empty-icon-success">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <h5>
                        All Stock Levels Are Healthy
                    </h5>

                    <p>
                        No active medicine is currently below its reorder level.
                    </p>

                </div>
            }

        </div>


        <!-- =========================================================
             STOCK DISTRIBUTION
             ========================================================= -->
        <div class="report-section">

            <div class="section-header">

                <div class="section-title-group">

                    <div class="section-icon icon-teal">
                        <i class="bi bi-pie-chart"></i>
                    </div>

                    <div>
                        <h4>
                            Stock Distribution
                        </h4>

                        <p>
                            Overview of inventory quantities by location.
                        </p>
                    </div>

                </div>

            </div>


            <div class="distribution-grid">

                <div class="distribution-card">

                    <div class="distribution-top">
                        <span>
                            Warehouse
                        </span>

                        <i class="bi bi-building"></i>
                    </div>

                    <h3>
                        @Model.StockSummary.TotalWarehouseQuantity.ToString("N2")
                    </h3>

                    <div class="progress-container">

                        @{
                            var warehousePercentage =
                                Model.StockSummary.TotalQuantity > 0
                                    ? (Model.StockSummary.TotalWarehouseQuantity /
                                       Model.StockSummary.TotalQuantity) * 100
                                    : 0;
                        }

                        <div class="progress-bar">

                            <div class="progress-fill progress-teal"
                                 style="width:@warehousePercentage.ToString("0.##")%">
                            </div>

                        </div>

                        <span>
                            @warehousePercentage.ToString("0.##")%
                        </span>

                    </div>

                </div>


                <div class="distribution-card">

                    <div class="distribution-top">

                        <span>
                            Pharmacy
                        </span>

                        <i class="bi bi-hospital"></i>

                    </div>

                    <h3>
                        @Model.StockSummary.TotalPharmacyQuantity.ToString("N2")
                    </h3>

                    <div class="progress-container">

                        @{
                            var pharmacyPercentage =
                                Model.StockSummary.TotalQuantity > 0
                                    ? (Model.StockSummary.TotalPharmacyQuantity /
                                       Model.StockSummary.TotalQuantity) * 100
                                    : 0;
                        }

                        <div class="progress-bar">

                            <div class="progress-fill progress-blue"
                                 style="width:@pharmacyPercentage.ToString("0.##")%">
                            </div>

                        </div>

                        <span>
                            @pharmacyPercentage.ToString("0.##")%
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             DETAILED STOCK SUMMARY
             ========================================================= -->
        <div class="report-section">

            <div class="section-header">

                <div class="section-title-group">

                    <div class="section-icon icon-teal">
                        <i class="bi bi-table"></i>
                    </div>

                    <div>
                        <h4>
                            Detailed Stock Summary
                        </h4>

                        <p>
                            Complete inventory breakdown by medicine, batch and location.
                        </p>
                    </div>

                </div>


                <div class="report-actions">

                    <button type="button"
                            id="printReportBtn"
                            class="report-action-btn secondary">

                        <i class="bi bi-printer"></i>
                        Print

                    </button>


                    <button type="button"
                            id="exportStockCsvBtn"
                            class="report-action-btn primary">

                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        Export CSV

                    </button>

                </div>

            </div>


            <div class="stock-filter-panel">

                <div class="filter-group search-group">

                    <label for="stockSearch">
                        Search
                    </label>

                    <div class="search-input-wrapper">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="stockSearch"
                               class="stock-filter-input"
                               placeholder="Search medicine or batch..."
                               autocomplete="off" />

                    </div>

                </div>


                <div class="filter-group">

                    <label for="locationFilter">
                        Location
                    </label>

                    <select id="locationFilter"
                            class="stock-filter-input">

                        <option value="all">
                            All Locations
                        </option>

                        <option value="warehouse">
                            Warehouse
                        </option>

                        <option value="pharmacy">
                            Pharmacy
                        </option>

                    </select>

                </div>


                <div class="filter-action">
                    <!-- NAYA CLEAR BUTTON YAHAN ADD KIYA GAYA HAI -->
                    <button type="button" id="clearStockFilters" class="clear-filter-btn">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>

            </div>


            <div class="filter-result-bar">

                <span id="filterResultText">

                    Showing

                    <strong id="visibleStockCount">
                        @Model.StockSummary.StockItems.Count
                    </strong>

                    of

                    <strong>
                        @Model.StockSummary.StockItems.Count
                    </strong>

                    records

                </span>

            </div>


            @if (Model.StockSummary.StockItems.Any())
            {
                <div class="table-wrapper">

                    <table class="report-table"
                           id="stockSummaryTable">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>Medicine</th>
                                <th>Batch</th>
                                <th>Location</th>
                                <th>Quantity</th>
                                <th>Last Updated</th>
                            </tr>

                        </thead>

                        <tbody id="stockSummaryBody">

                            @{
                                int stockCounter = 1;
                            }

                            @foreach (var stock in Model.StockSummary.StockItems)
                            {
                                <tr class="stock-row"
                                    data-medicine="@stock.MedicineName.ToLowerInvariant()"
                                    data-batch="@stock.BatchNumber.ToLowerInvariant()"
                                    data-location="@(stock.Location == 1 ? "warehouse" : stock.Location == 2 ? "pharmacy" : "unknown")">

                                    <td class="stock-row-number">
                                        @stockCounter
                                    </td>

                                    <td>

                                        <div class="medicine-name">

                                            <strong>
                                                @stock.MedicineName
                                            </strong>

                                            <span>
                                                Medicine ID: @stock.MedicineId
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="code-badge">
                                            @stock.BatchNumber
                                        </span>

                                    </td>

                                    <td>

                                        @if (stock.Location == 1)
                                        {
                                            <span class="location-badge warehouse">

                                                <i class="bi bi-building"></i>
                                                Warehouse

                                            </span>
                                        }
                                        else if (stock.Location == 2)
                                        {
                                            <span class="location-badge pharmacy">

                                                <i class="bi bi-hospital"></i>
                                                Pharmacy

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="location-badge">
                                                Unknown
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <strong class="qty-highlight">
                                            @stock.Quantity.ToString("N2")
                                        </strong>

                                    </td>

                                    <td>

                                        <span class="updated-date">
                                            @(stock.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                        </span>

                                    </td>

                                </tr>

                                stockCounter++;
                            }

                        </tbody>

                    </table>

                </div>


                <div class="filter-empty-state"
                     id="filterEmptyState"
                     style="display:none;">

                    <div class="empty-icon empty-icon-teal">

                        <i class="bi bi-search"></i>

                    </div>

                    <h5>
                        No Matching Stock Records
                    </h5>

                    <p>
                        Try changing your search text or location filter.
                    </p>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon empty-icon-teal">

                        <i class="bi bi-box"></i>

                    </div>

                    <h5>
                        No Stock Records Found
                    </h5>

                    <p>
                        There are currently no inventory records available.
                    </p>

                </div>
            }

        </div>
    }

</div>


