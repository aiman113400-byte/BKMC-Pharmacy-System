}

html[data-theme="dark"] .reports-page .monthly-sales-card h4,
html[data-theme="dark"] .reports-page .monthly-sales-card h5 {
    color: #FFFFFF !important;
}

html[data-theme="dark"] .reports-page .monthly-sales-table-wrapper {
