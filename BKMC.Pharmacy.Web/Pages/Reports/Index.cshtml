        padding: 10px 14px;
        text-align: left;
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 700;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e9edf3;
        white-space: nowrap;
    }

    .report-table td {
        padding: 11px 14px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #1e293b;
        font-size: 0.78rem;
    }

    .report-table tbody tr:last-child td {
        border-bottom: none;
    }

    .report-table tbody tr {
        transition: background-color 0.15s ease;
    }

    .report-table tbody tr:hover {
        background: #f0fdfa;
    }


    /* =========================================================
       MEDICINE NAME
       ========================================================= */

    .medicine-name {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .medicine-name strong {
        color: #0f172a;
        font-weight: 700;
        font-size: 0.78rem;
    }

    .medicine-name span {
        font-size: 0.66rem;
        color: #94a3b8;
    }


    /* =========================================================
       CODE BADGE
       ========================================================= */

    .code-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 5px;
        background: #e2f5ef;
        color: #0f766e;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }


    /* =========================================================
       QUANTITY HIGHLIGHT
       ========================================================= */

    .qty-highlight {
        color: #0f766e;
        font-weight: 800;
        font-size: 0.82rem;
    }


    /* =========================================================
       STATUS BADGE
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 9px;
        border-radius: 20px;
        background: #fee2e2;
        color: #991b1b;
        font-size: 0.66rem;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        text-align: center;
        padding: 35px 20px;
    }

    .empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 12px;
    }

    .empty-icon-success {
        background: #dcfce7;
        color: #16a34a;
    }

    .empty-icon-teal {
        background: #e2f5ef;
        color: #0f766e;
    }

    .empty-state h5 {
        margin-bottom: 5px;
        font-weight: 700;
        color: #0f172a;
        font-size: 0.9rem;
    }

    .empty-state p {
        margin: 0;
        color: #64748b;
        font-size: 0.78rem;
    }


    /* =========================================================
       STOCK DISTRIBUTION - COMPACT
       ========================================================= */

    .distribution-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        padding: 16px 18px;
    }

    .distribution-card {
        padding: 16px 18px;
        border: 1px solid #e9edf3;
        border-radius: 10px;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        transition: all 0.15s ease;
    }

    .distribution-card:hover {
        border-color: #ccece3;
        box-shadow: 0 3px 10px rgba(15, 118, 110, 0.05);
    }

    .distribution-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .distribution-top i {
        font-size: 18px;
        color: #0f766e;
    }

    .distribution-card h3 {
        margin: 10px 0 14px;
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .progress-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .progress-container > span {
        font-size: 0.72rem;
        min-width: 42px;
        text-align: right;
        color: #0f766e;
        font-weight: 700;
    }

    .progress-bar {
        flex: 1;
        height: 6px;
        border-radius: 10px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: inherit;
        transition: width 0.4s ease;
    }

    .progress-teal {
        background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .progress-blue {
        background: linear-gradient(90deg, #0284c7 0%, #38bdf8 100%);
    }


    /* =========================================================
       STOCK FILTERS - COMPACT
       ========================================================= */

    .stock-filter-panel {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 180px auto;
        align-items: end;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafbfc;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .filter-group label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
    }

    .search-input-wrapper {
        position: relative;
    }

    .search-input-wrapper i {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
        font-size: 0.85rem;
    }

    .stock-filter-input {
        width: 100%;
        height: 34px;
        padding: 7px 12px;
        border-radius: 7px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #1e293b;
        font-size: 0.78rem;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .search-input-wrapper .stock-filter-input {
        padding-left: 34px;
    }

    .stock-filter-input::placeholder {
        color: #94a3b8;
    }

    .stock-filter-input:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.1);
    }

    .filter-action {
        display: flex;
        align-items: center;
    }

    .clear-filter-btn {
        height: 34px;
        padding: 0 13px;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        background: #ffffff;
        color: #374151;
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .clear-filter-btn:hover {
        border-color: #0f766e;
        color: #0f766e;
        background: #f0fdfa;
    }


    /* =========================================================
       FILTER RESULT BAR
       ========================================================= */

    .filter-result-bar {
        display: flex;
        align-items: center;
        padding: 9px 18px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.72rem;
        color: #64748b;
        background: #ffffff;
    }

    .filter-result-bar strong {
        color: #0f766e;
        font-weight: 700;
    }


    /* =========================================================
       FILTER EMPTY STATE
       ========================================================= */

    .filter-empty-state {
        text-align: center;
        padding: 35px 20px;
    }


    /* =========================================================
       LOCATION BADGES
       ========================================================= */

    .location-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 0.66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .location-badge.warehouse {
        background: #e2f5ef;
        color: #0f766e;
    }

    .location-badge.pharmacy {
        background: #e0f2fe;
        color: #0284c7;
    }

    .location-badge i {
        font-size: 11px;
    }

    .updated-date {
        font-size: 0.72rem;
        color: #64748b;
        white-space: nowrap;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .daily-sales-summary-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .monthly-sales-summary-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

    }

    @@media (max-width: 1100px) {

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .stock-filter-panel {
            grid-template-columns: 1fr 180px auto;
        }

        .daily-sales-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .monthly-sales-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }

    @@media (max-width: 800px) {

        .stock-filter-panel {
            grid-template-columns: 1fr;
        }

        .filter-action {
            width: 100%;
        }

        .clear-filter-btn {
            width: 100%;
            justify-content: center;
        }

        .report-actions {
            width: 100%;
        }

        .report-action-btn {
            flex: 1;
        }

        .daily-sales-date-form {
            width: 100%;
            min-width: 0;
        }

        .daily-sales-date-control {
            width: 100%;
        }

        .daily-sales-date-input {
            flex: 1;
        }

        .daily-sales-summary-grid {
            grid-template-columns: 1fr;
        }

        .monthly-sales-header {
            align-items: flex-start;
        }

        .monthly-sales-date-form {
            width: 100%;
            align-items: stretch;
        }

        .monthly-sales-field {
            flex: 1;
        }

        .monthly-sales-select,
        .monthly-sales-view-btn {
            width: 100%;
        }

    }

    @@media (max-width: 700px) {

        .page-header {
            flex-direction: column;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .distribution-grid {
            grid-template-columns: 1fr;
        }

        .report-date {
            width: 100%;
            text-align: center;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .report-actions {
            width: 100%;
        }

        .report-action-btn {
            width: 100%;
            flex: none;
        }

        .daily-sales-date-display {
            flex-direction: column;
            align-items: flex-start;
        }

        .daily-sales-date-control {
            flex-direction: column;
            align-items: stretch;
        }

        .daily-sales-date-input,
        .daily-sales-view-btn {
            width: 100%;
        }

        .daily-sales-table-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .monthly-sales-summary-grid {
            grid-template-columns: 1fr;
        }

        .monthly-sales-date-form {
            flex-direction: column;
        }

    }


    /* =========================================================
       PRINT
       ========================================================= */

    @@media print {

        @@page {
            size: A4 landscape;
            margin: 12mm;
        }

        body {
            background: #ffffff !important;
            color: #000000 !important;
        }

        .reports-page {
            width: 100% !important;
            background: #ffffff !important;
            color: #000000 !important;
        }

        .page-header {
            margin-bottom: 12px !important;
        }

        .page-header h2 {
            color: #000000 !important;
        }

        .page-subtitle {
            color: #555555 !important;
        }

        .report-date {
            background: #ffffff !important;
            color: #000000 !important;
            border-color: #cccccc !important;
        }

        .summary-grid,
        .daily-sales-summary-grid,
        .monthly-sales-summary-grid {
            gap: 8px !important;
        }

        .summary-card,
        .sales-summary-card,
        .monthly-sales-card,
        .report-section,
        .distribution-card {
            background: #ffffff !important;
            color: #000000 !important;
            border-color: #cccccc !important;
            box-shadow: none !important;
        }

        .summary-icon,
        .sales-summary-icon,
        .monthly-sales-card-icon {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .stock-filter-panel,
        .filter-result-bar,
        .report-actions,
        .clear-filter-btn,
        .daily-sales-date-form,
        .monthly-sales-date-form {
            display: none !important;
        }

        .report-section {
            margin-bottom: 12px !important;
            break-inside: avoid;
        }

        .section-header {
            border-color: #cccccc !important;
            padding: 10px 12px !important;
        }

        .section-header h4,
        .section-header p {
            color: #000000 !important;
        }

        .monthly-sales-period {
            color: #000000 !important;
            background: #ffffff !important;
            border-color: #cccccc !important;
        }

        .monthly-sales-table-wrapper {
            margin: 0 !important;
            border-color: #cccccc !important;
        }

        .monthly-sales-table-wrapper .table-title {
            background: #ffffff !important;
            border-color: #cccccc !important;
        }

        .monthly-sales-table-wrapper .table-title h3 {
            color: #000000 !important;
        }

        .table-wrapper {
            overflow: visible !important;
        }

        .report-table {
            width: 100% !important;
            min-width: 0 !important;
            color: #000000 !important;
        }

        .report-table th,
        .report-table td {
            color: #000000 !important;
            border-color: #cccccc !important;
        }

        .report-table tbody tr:hover {
            background: transparent !important;
        }

        .location-badge,
        .code-badge,
        .status-badge,
        .bill-number-badge,
        .paid-status-badge,
        .medicine-count-badge {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .updated-date,
        .sales-time {
            color: #444444 !important;
        }

        .progress-bar {
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

    }
   /* =========================================================
   REPORTS PAGE - PROFESSIONAL DARK MODE
