@page
@model BKMC.Pharmacy.Web.Pages.Bills.CreateModel

@{
    ViewData["Title"] = "Create Bill";
}

<style>
    /* Professional Theme Colors */
    .bg-teal { background-color: #0f766e !important; }
    .text-teal { color: #0f766e !important; }
    .btn-teal { background-color: #0f766e; color: white; border: none; }
    .btn-teal:hover { background-color: #0d5c56; color: white; }
    
    /* Card Styling */
    .card-custom {
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        overflow: hidden;
        background-color: #ffffff;
    }
    .card-header-custom {
        background-color: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 1.25rem 1.5rem;
    }
    
    /* Form Controls */
    .form-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
    }
    .form-control, .form-select {
        border-radius: 0.5rem;
        border-color: #cbd5e1;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #0f766e;
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
    }
    
    /* Table Styling */
    .table-custom th {
        background-color: #f0fdfa;
        color: #475569;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem;
    }
    .table-custom td {
        padding: 1rem 1.25rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
    }
    .table-custom tbody tr:hover {
        background-color: #f8fafc;
    }
    .table-custom input {
        min-width: 80px;
    }
</style>

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Create Bill</h2>
            <p class="text-muted mb-0 small">Create a patient billing record</p>
        </div>

        <a asp-page="./Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3 py-2" style="border-radius: 0.5rem; font-weight: 500;">
            <i class="bi bi-arrow-left"></i>
            Back to Bills
        </a>
    </div>

    <!-- Billing Form -->
    <form method="post">

        <!-- Validation Summary -->
        <div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm" style="border-radius: 0.75rem;"></div>

        <!-- Card 1: Bill Information -->
        <div class="card-custom mb-4">
            <div class="card-header-custom">
                <h5 class="mb-0 fw-semibold text-dark">Bill Information</h5>
            </div>

            <div class="card-body p-4">
                <div class="row">
                    <!-- Patient -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bill.PatientId" class="form-label">Patient</label>
                        <select asp-for="Bill.PatientId" class="form-select">
                            <option value="0">-- Select Patient --</option>
                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.Id">@patient.MRNumber - @patient.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Bill.PatientId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Bill Date -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bill.BillDate" class="form-label">Bill Date</label>
                        <input asp-for="Bill.BillDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Bill.BillDate" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Dispensing -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bill.DispensingId" class="form-label">Dispensing</label>
                        <select asp-for="Bill.DispensingId" class="form-select">
                            <option value="">-- Select Dispensing (Optional) --</option>
                            @foreach (var dispensing in Model.Dispensings)
                            {
                                <option value="@dispensing.Id">
                                    @dispensing.MRNumber - @dispensing.PatientName - @dispensing.DispensingDate.ToString("dd MMM yyyy")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Paid Amount -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Bill.PaidAmount" class="form-label">Paid Amount</label>
                        <input asp-for="Bill.PaidAmount" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Bill.PaidAmount" class="text-danger small mt-1 d-block"></span>
                        <small class="text-muted d-block mt-1">Enter the amount paid by the patient.</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Bill Items -->
        <div class="card-custom mb-4">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold text-dark">Bill Items</h5>
                <button type="button" id="addItemBtn" class="btn btn-teal btn-sm px-3 py-2" style="border-radius: 0.5rem; font-weight: 500;">
                    <i class="bi bi-plus-lg me-1"></i> Add Item
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-custom mb-0 w-100" id="billItemsTable">
                        <thead>
                            <tr>
                                <th>Medicine</th>
                                <th style="width: 160px;">Quantity</th>
                                <th style="width: 180px;">Unit Price</th>
                                <th style="width: 80px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="billItemsBody">
                            <tr class="bill-item-row">
                                <td>
                                    <select name="Bill.Items[0].MedicineId" class="form-select">
                                        <option value="">-- Select Medicine --</option>
                                        @foreach (var medicine in Model.Medicines)
                                        {
                                            <option value="@medicine.Id">@medicine.Name (@medicine.Strength)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="Bill.Items[0].Quantity" class="form-control" min="0.01" step="0.01" value="1" />
                                </td>
                                <td>
                                    <input type="number" name="Bill.Items[0].UnitPrice" class="form-control" min="0" step="0.01" value="0" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-item" style="border-radius: 0.375rem;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-page="./Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 0.5rem; font-weight: 500;">
                Cancel
            </a>
            <button type="submit" class="btn btn-teal px-4 py-2" style="border-radius: 0.5rem; font-weight: 500;">
                <i class="bi bi-check-lg me-1"></i> Create Bill
            </button>
        </div>

    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        let itemIndex = 1;

        document.getElementById("addItemBtn").addEventListener("click", function () {
            const tbody = document.getElementById("billItemsBody");
            const row = document.createElement("tr");
            row.className = "bill-item-row";

            // JavaScript template with updated styling classes
            row.innerHTML = `
                <td>
                    <select name="Bill.Items[${itemIndex}].MedicineId" class="form-select">
                        <option value="">-- Select Medicine --</option>
                        @foreach (var medicine in Model.Medicines)
                        {
                            <option value="@medicine.Id">@medicine.Name (@medicine.Strength)</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="number" name="Bill.Items[${itemIndex}].Quantity" class="form-control" min="0.01" step="0.01" value="1" />
                </td>
                <td>
                    <input type="number" name="Bill.Items[${itemIndex}].UnitPrice" class="form-control" min="0" step="0.01" value="0" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-item" style="border-radius: 0.375rem;">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);
            itemIndex++;
        });

        document.getElementById("billItemsBody").addEventListener("click", function (event) {
            const button = event.target.closest(".remove-item");
            if (!button) return;

            const rows = document.querySelectorAll("#billItemsBody .bill-item-row");
            if (rows.length <= 1) {
                return;
            }

            button.closest("tr").remove();
        });
    </script>
}



